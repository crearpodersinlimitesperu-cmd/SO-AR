rules_version = '2';
// ============================================================================
// firestore.rules — SO-AR / centro-operativo-cpsl
// Auditada línea por línea contra el uso real de Firestore en el código (26/08/2026):
// se revisaron todas las llamadas collection(db, ...) / doc(db, ...) del proyecto y
// se confirmó que las 14 colecciones que la app usa hoy están cubiertas abajo, ya sea
// con una regla específica o dejadas explícitamente abiertas (ver sección "Qué NO
// cambia"). Enviada a despliegue el 26/08/2026 con confirmación explícita de Jose.
//
// Qu├® resuelve respecto a lo que est├í activo hoy en producci├│n:
//  1. Elimina el `match /{document=**} { allow read, write: if request.auth != null; }`
//     que permite a CUALQUIER usuario autenticado (sin importar rol o sede) leer y
//     escribir CUALQUIER documento de CUALQUIER colecci├│n.
//  2. Cierra la escritura p├║blica en colecciones de Nodus; las automatizaciones
//     deben publicar con credenciales de backend, no con secretos en documentos.
//  3. Usa el correo (request.auth.token.email) para verificar due├▒o/rol en vez de
//     request.auth.uid ÔÇö porque toda la app (AuthContext, ChecklistContext,
//     NotificationContext, auditService, etc.) guarda userId/ownerId/assignedToEmail
//     como CORREO, nunca como el uid real de Firebase Auth. Esa es la causa ra├¡z del
//     Hallazgo #2 de la auditor├¡a original (notificaciones, colaboraci├│n, venues,
//     ciclos y reportes fallando en silencio para roles no-superadmin).
//
// Qu├® NO cambia (a prop├│sito, para no romper nada que no revis├® a fondo):
//  Las colecciones staff_directory, managers_directory, excellence_standards, kpi_reports,
//  learning_logs y success_patterns se dejan EXACTAMENTE como est├ín hoy (cualquier autenticado lee y
//  escribe) porque no alcanc├® a auditar el detalle de cada una y prefiero no
//  inventar una restricci├│n que bloquee algo que no vi. Quedan marcadas abajo
//  con un TODO para una siguiente pasada.
//  A-01 (parcial): qt_directory (solo escritura), sync_history y
//  user_stats ya tienen reglas específicas más abajo.
//
// Lista de gerencia/direcci├│n (funci├│n isGerenteODireccion): se extrajo del
// ├║ltimo snapshot de src/data/usersToImport.js en GitHub (anterior a la
// migraci├│n a Firestore). Esa lista puede estar desactualizada ÔÇö rev├¡sala y
// corr├¡gela antes de desplegar. Debe mantenerse igual que
// src/config/permissions.js (GERENCIA_ROLES/SUPER_ADMIN_EMAILS); no se
// sincronizan solas, as├¡ que si cambia gerencia hay que actualizar AMBOS lugares.
//
// ACTUALIZACIÓN 29/08/2026 (confirmada explícitamente por José): se agregó
// isOperationalProgressUpdate() en la regla de "tasks" — ver esa función más abajo
// para el detalle del bug real que corrige (permission-denied al marcar checklists
// del catálogo base, reportado como "Revisa los permisos de Firestore").
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function normalizedCorpEmail(addr) {
      return addr.lower()
        .replace('@crearpls[.]com$', '@crearpsl.net')
        .replace('@crearpsl[.]com$', '@crearpsl.net');
    }

    function participantEmail(key) {
      let normalized = normalizedCorpEmail(key);
      return {
        'milacampuzano21@gmail.com': 'emily.campuzano@crearpsl.net',
        'ricardogavilanez1021@gmail.com': 'ricardo.gavilanez@crearpsl.net',
        'brunische66@gmail.com': 'leandro.brunis@crearpsl.net',
        'gomeznueve@gmail.com': 'andres.gomez@crearpsl.net',
        'jorgeramirezmorejon@gmail.com': 'jorge.ramirez@crearpsl.net',
        'cardenasgina29@gmail.com': 'gina.cardenas@crearpsl.net',
        'cardenaslopezgina@gmail.com': 'gina.cardenas@crearpsl.net',
        'santiago.proao527@gmail.com': 'sso@crearpsl.net',
        'maboadar@gmail.com': 'direccion@bmbgbrokers.com'
      }.get(normalized, normalized);
    }

    function emailAliases(addr) {
      let e = addr.lower();
      let parts = e.split('@');
      let fallback = parts.size() == 2 && parts[1] in ['crearpsl.net', 'crearpsl.com', 'crearpls.com']
        ? [parts[0] + '@crearpsl.net', parts[0] + '@crearpsl.com', parts[0] + '@crearpls.com']
        : [e];
      let brunis = ['brunische66@gmail.com', 'carlos.brunis@crearpsl.net', 'carlos.brunis@crearpsl.com', 'leandro.brunis@crearpsl.net', 'leandro.brunis@crearpsl.com', 'leandro.brunis@crearpls.com'];
      return {
        'emily.campuzano@crearpsl.net': ['milacampuzano21@gmail.com', 'emily.campuzano@crearpsl.net', 'emily.campuzano@crearpsl.com', 'emily.campuzano@crearpls.com'],
        'ricardo.gavilanez@crearpsl.net': ['ricardogavilanez1021@gmail.com', 'ricardo.gavilanez@crearpsl.net', 'ricardo.gavilanez@crearpsl.com', 'ricardo.gavilanez@crearpls.com'],
        'leandro.brunis@crearpsl.net': brunis,
        'carlos.brunis@crearpsl.net': brunis,
        'andres.gomez@crearpsl.net': ['gomeznueve@gmail.com', 'andres.gomez@crearpsl.net', 'andres.gomez@crearpsl.com', 'andres.gomez@crearpls.com'],
        'jorge.ramirez@crearpsl.net': ['jorgeramirezmorejon@gmail.com', 'jorge.ramirez@crearpsl.net', 'jorge.ramirez@crearpsl.com', 'jorge.ramirez@crearpls.com'],
        'gina.cardenas@crearpsl.net': ['cardenasgina29@gmail.com', 'cardenaslopezgina@gmail.com', 'gina.cardenas@crearpsl.net', 'gina.cardenas@crearpsl.com', 'gina.cardenas@crearpls.com'],
        'sso@crearpsl.net': ['santiago.proao527@gmail.com', 'sso@crearpsl.net', 'sso@crearpsl.com', 'sso@crearpls.com'],
        'direccion@bmbgbrokers.com': ['maboadar@gmail.com', 'direccion@bmbgbrokers.com']
      }.get(participantEmail(e), fallback);
    }

    function callerEmailAliases() {
      return isAuthenticated() ? emailAliases(email()) : [];
    }

    // Debe coincidir con SUPER_ADMIN_EMAILS en src/config/permissions.js
    function isSuperAdmin() {
      return isAuthenticated() && participantEmail(email()) in [
        'jose.sanchez@crearpsl.net',
        'armando.pilacuan@gmail.com',
        'paul.sosa@crearpsl.net'
      ];
    }

    // Lista extra├¡da de usersToImport.js (snapshot GitHub, roles gerente/direccion/
    // cfo/cco/ceo/director_maestria/socio). VERIFICAR Y CORREGIR antes de desplegar.
    function isGerenteODireccion() {
      return isSuperAdmin() || (isAuthenticated() && participantEmail(email()) in [
        'ricardo.gavilanez@crearpsl.net',
        'fer.aragon@crearpsl.net',
        'andres.gomez@crearpsl.net',
        'contabilidad.global@crearpsl.net',
        'leandro.brunis@crearpsl.net',
        'josue.vera@crearpsl.net',
        'yurany.gonzalez@crearpsl.net',
        'nora.zamora@crearpsl.net',
        'emily.campuzano@crearpsl.net',
        'freddy.sosa@crearpsl.net',
        'diana.moscoso@crearpsl.net'
      ]);
    }

    function isOwnerWithAliases(resourceData, callerEmails) {
      let assignedToEmail = resourceData.get('assignedToEmail', '');
      let assignedTo = resourceData.get('assigned_to', '');
      let ownerId = resourceData.get('ownerId', '');
      let assignedByEmail = resourceData.get('assignedByEmail', '');
      let createdBy = resourceData.get('createdBy', '');
      let createdByEmail = resourceData.get('createdByEmail', '');
      let createdByLegacy = resourceData.get('created_by', '');
      let assignedList = resourceData.get('assignedToEmails', []);
      return isAuthenticated() && (
        (assignedToEmail is string && assignedToEmail != '' && assignedToEmail.lower() in callerEmails) ||
        (assignedTo is string && assignedTo != '' && assignedTo.lower() in callerEmails) ||
        (assignedList is list && (email() in assignedList || assignedList.hasAny(callerEmails))) ||
        ownerId == request.auth.uid ||
        (assignedByEmail is string && assignedByEmail != '' && assignedByEmail.lower() in callerEmails) ||
        (createdBy is string && createdBy != '' && createdBy.lower() in callerEmails) ||
        (createdByEmail is string && createdByEmail != '' && createdByEmail.lower() in callerEmails) ||
        (createdByLegacy is string && createdByLegacy != '' && createdByLegacy.lower() in callerEmails)
      );
    }

    function isOwner(resourceData) {
      return isOwnerWithAliases(resourceData, callerEmailAliases());
    }

    function isCollaboratorWithAliases(resourceData, callerEmails) {
      let collaborators = resourceData.get('collaborators', []);
      return isAuthenticated() &&
        collaborators is list &&
        collaborators.hasAny(callerEmails);
    }

    function isCollaborator(resourceData) {
      return isCollaboratorWithAliases(resourceData, callerEmailAliases());
    }

    function isTaskRecipientWithAliases(resourceData, aliases) {
      let callerEmail = isAuthenticated() ? email() : '';
      let al = aliases;
      let rawAssigned = resourceData.get('assignedToEmail', '');
      let a0 = al.size() > 0 ? al[0] : callerEmail;
      let a1 = al.size() > 1 ? al[1] : callerEmail;
      let a2 = al.size() > 2 ? al[2] : callerEmail;
      let a3 = al.size() > 3 ? al[3] : callerEmail;
      let a4 = al.size() > 4 ? al[4] : callerEmail;
      let a5 = al.size() > 5 ? al[5] : callerEmail;
      return isAuthenticated() && (
        (rawAssigned is string && rawAssigned != '' &&
         (rawAssigned.lower() == callerEmail || rawAssigned.lower() in al)) ||
        (resourceData.keys().hasAny(['assignedToEmails']) &&
         (callerEmail in resourceData.assignedToEmails ||
          a0 in resourceData.assignedToEmails ||
          a1 in resourceData.assignedToEmails ||
          a2 in resourceData.assignedToEmails ||
          a3 in resourceData.assignedToEmails ||
          a4 in resourceData.assignedToEmails ||
          a5 in resourceData.assignedToEmails))
      );
    }

    function isTaskRecipient(resourceData) {
      return isTaskRecipientWithAliases(resourceData, isAuthenticated() ? callerEmailAliases() : ['']);
    }

    function hasNonEmptyStr(d, k) {
      let v = d.get(k, '');
      return v is string && v != '';
    }

    function isProfileInactive(u) {
      let status = u.get('status', '');
      let rolesList = u.get('roles', []);
      return u.get('active', true) == false ||
        u.get('isActive', true) == false ||
        u.get('role', '') == 'inactivo' ||
        u.get('rol', '') == 'inactivo' ||
        u.get('appRole', '') == 'inactivo' ||
        (rolesList is list && 'inactivo' in rolesList) ||
        (status is string && status in ['inactive', 'inactivo', 'baja', 'renuncia', 'desvinculado']);
    }

    function hasProfileRoleFields(u) {
      let r = u.get('roles', []);
      return u.keys().hasAny(['role', 'rol', 'appRole', 'roles']) && (
        hasNonEmptyStr(u, 'role') ||
        hasNonEmptyStr(u, 'rol') ||
        hasNonEmptyStr(u, 'appRole') ||
        (r is list && r.size() > 0)
      );
    }

    function roleAliasesFor(targetRole) {
      return {
        'coord_c1': ['coord_c1', 'coordinador_c1', 'coordinador_c1c2', 'coord_c1_c2', 'coord_jr'],
        'coord_maestria': ['coord_maestria', 'coordinador_mj', 'coordinador_maestria', 'director_maestria'],
        'qt': ['qt', 'quantum_team', 'coord_qt', 'coordinador_qt'],
        'entrenador': ['entrenador', 'coach', 'entrenador_llamadas']
      }.get(targetRole, [targetRole]);
    }

    function rosterCoordC1(e) {
      return e.matches('^(adrianna[.]guarochico@crearpsl[.]net|alfonso[.]trujillo@crearpsl[.]net|brenda[.]rodriguez@crearpsl[.]net|cardenasgina29@gmail[.]com|cardenaslopezgina@gmail[.]com|daniela[.]esposito@crearpsl[.]net|danna[.]guaman@crearpsl[.]net|david[.]gonzalez@crearpsl[.]net|diana[.]macas@crearpsl[.]net|diana[.]moscoso@crearpsl[.]net|evelyn[.]cedillo@crearpsl[.]net|gina[.]cardenas@crearpsl[.]net|jorge[.]ramirez@crearpsl[.]net|jorgeramirezmorejon@gmail[.]com|joyce[.]marin@crearpsl[.]net|karla[.]pastrano@crearpsl[.]net|katherine[.]aguirre@crearpsl[.]net|marco[.]gonzalez@crearpsl[.]net|naomi[.]campos@crearpsl[.]net|valentina[.]r@crearpsl[.]net|viviana[.]catota@crearpsl[.]net)$');
    }

    function rosterCoordMaestria(e) {
      return e.matches('^(andres[.]gomez@crearpsl[.]net|daniela[.]monroy@crearpsl[.]net|erika[.]gavilanez@crearpsl[.]net|gomeznueve@gmail[.]com|ibetancourth@crearpsl[.]net|jonathan[.]larosa@crearpsl[.]net|juan[.]reinoso@crearpsl[.]net|judith[.]romero@crearpsl[.]net|kerly[.]carrillo@crearpsl[.]net|liliana[.]cubillo@crearpsl[.]net|lili[.]cubillo@crearpsl[.]net|linid[.]valencia@crearpsl[.]net|mauricio[.]ramirez@crearpsl[.]net)$');
    }

    function rosterDirectorMaestria(e) {
      return e.matches('^(andres[.]gomez@crearpsl[.]net|gomeznueve@gmail[.]com)$');
    }

    function rosterQt(e) {
      return e.matches('^(alemunoz160@gmail[.]com|alexandra[.]vivas2714@gmail[.]com|anahirp04@gmail[.]com|ar2887493@gmail[.]com|belengarciavm@gmail[.]com|brunische66@gmail[.]com|cardenasgina29@gmail[.]com|cardenaslopezgina@gmail[.]com|carlos[.]brunis@crearpsl[.]net|darwindelgado@hotmail[.]com|dayapamae[.]villarodriguez14@gmail[.]com|dayizambrano24@gmail[.]com|deniseins[.]de@gmail[.]com|ferchas_tk@gmail[.]com|gabriela[.]altuna@crearpsl[.]net|gaveroba@gmail[.]com|geovyta79@gmail[.]com|gina[.]cardenas@crearpsl[.]net|hackerxavi@gmail[.]com|jorge[.]ramirez@crearpsl[.]net|jorgeramirezmorejon@gmail[.]com|josseth2008@gmail[.]com|joysherva@gmail[.]com|juandiegojarar@gmail[.]com|kathi[.]pereira2002@gmail[.]com|lizarate1977@gmail[.]com|maferflores2013@gmail[.]com|magymqm70@gmail[.]com|marobel[.]studio@gmail[.]com|marthanal216@hotmail[.]com|merleyudaza@gmail[.]com|mguerrero[.]technetca@gmail[.]com|mmartinezxg@gmail[.]com|myriampamelat@gmail[.]com|ninoska01051978@gmail[.]com|prunaluis@gmail[.]com|ricardo[.]gavilanez@crearpsl[.]net|ricardogavilanez1021@gmail[.]com|rocio81rocio@gmail[.]com|rouz1414@gmail[.]com|salarcons@gmail[.]com|vanessadelcisne@gmail[.]com|vascosofy@gmail[.]com|willocse87@gmail[.]com)$');
    }

    function rosterEntrenador(e) {
      return e.matches('^(anamonroyt@gmail[.]com|andres[.]gomez@crearpsl[.]net|brunische66@gmail[.]com|carlos[.]brunis@crearpsl[.]net|chuyacostar88@gmail[.]com|jesus[.]acosta@crearpsl[.]net|jesusadrianacosta@gmail[.]com|ciriloagustin21@gmail[.]com|coor[.]operaciones2023@gmail[.]com|daniela[.]monroy@crearpsl[.]net|dibrafi@gmail[.]com|direccion@bmbgbrokers[.]com|e[.]andresid@gmail[.]com|emalejodiaz@gmail[.]com|emily[.]campuzano@crearpsl[.]net|erika[.]gavilanez@crearpsl[.]net|fer[.]aragon@crearpsl[.]net|fernandomendozaclavijo22@gmail[.]com|gomeznueve@gmail[.]com|jarreolamorales@gmail[.]com|jose[.]sanchez@crearpsl[.]net|josue[.]vera@crearpsl[.]net|judith[.]romero@crearpsl[.]net|kerly[.]carrillo@crearpsl[.]net|leandro[.]brunis@crearpsl[.]net|liliana[.]cubillo@crearpsl[.]net|lili[.]cubillo@crearpsl[.]net|linid[.]valencia@crearpsl[.]net|maboadar@gmail[.]com|marylourdespat@gmail[.]com|mauricio[.]ramirez@crearpsl[.]net|milacampuzano21@gmail[.]com|mildredmunozv@gmail[.]com|mperez[.]ttw@gmail[.]com|paul[.]sosa@crearpsl[.]net|solaresalonso@gmail[.]com)$');
    }

    function rosterEntrenadorLlamadas(e) {
      return e.matches('^(anamonroyt@gmail[.]com|andres[.]gomez@crearpsl[.]net|dibrafi@gmail[.]com|emalejodiaz@gmail[.]com|emily[.]campuzano@crearpsl[.]net|fernandomendozaclavijo22@gmail[.]com|gomeznueve@gmail[.]com|josue[.]vera@crearpsl[.]net|judith[.]romero@crearpsl[.]net|kerly[.]carrillo@crearpsl[.]net|liliana[.]cubillo@crearpsl[.]net|lili[.]cubillo@crearpsl[.]net|marylourdespat@gmail[.]com|milacampuzano21@gmail[.]com|mauricio[.]ramirez@crearpsl[.]net|daniela[.]monroy@crearpsl[.]net|erika[.]gavilanez@crearpsl[.]net|direccion@bmbgbrokers[.]com|maboadar@gmail[.]com)$');
    }

    function rosterGerente(e) {
      return e.matches('^(armando[.]pilacuan@gmail[.]com|diana[.]moscoso@crearpsl[.]net|emily[.]campuzano@crearpsl[.]net|freddy[.]sosa@crearpsl[.]net|jose[.]sanchez@crearpsl[.]net|josue[.]vera@crearpsl[.]net|milacampuzano21@gmail[.]com|nora[.]zamora@crearpsl[.]net|ricardo[.]gavilanez@crearpsl[.]net|ricardogavilanez1021@gmail[.]com|yurany[.]gonzalez@crearpsl[.]net)$');
    }

    function rosterDireccion(e) {
      return e.matches('^(andres[.]gomez@crearpsl[.]net|armando[.]pilacuan@gmail[.]com|contabilidad[.]global@crearpsl[.]net|fer[.]aragon@crearpsl[.]net|gomeznueve@gmail[.]com|leandro[.]brunis@crearpsl[.]net|paul[.]sosa@crearpsl[.]net)$');
    }

    function officialRosterHasRole(targetRole) {
      let e = normalizedCorpEmail(email());
      return (targetRole == 'coord_c1' && rosterCoordC1(e)) ||
        (targetRole == 'coord_maestria' && rosterCoordMaestria(e)) ||
        (targetRole == 'director_maestria' && rosterDirectorMaestria(e)) ||
        (targetRole == 'qt' && rosterQt(e)) ||
        (targetRole == 'entrenador' && rosterEntrenador(e)) ||
        (targetRole == 'entrenador_llamadas' && rosterEntrenadorLlamadas(e)) ||
        (targetRole == 'gerente' && rosterGerente(e)) ||
        (targetRole == 'direccion' && rosterDireccion(e));
    }

    function officialRosterHasAnyRole(roleNames) {
      let e = normalizedCorpEmail(email());
      return ('coord_c1' in roleNames && rosterCoordC1(e)) ||
        ('coord_maestria' in roleNames && rosterCoordMaestria(e)) ||
        ('director_maestria' in roleNames && rosterDirectorMaestria(e)) ||
        ('gerente' in roleNames && rosterGerente(e)) ||
        ('direccion' in roleNames && rosterDireccion(e)) ||
        ('qt' in roleNames && rosterQt(e)) ||
        ('entrenador' in roleNames && rosterEntrenador(e)) ||
        ('entrenador_llamadas' in roleNames && rosterEntrenadorLlamadas(e)) ||
        ('staff' in roleNames && e.matches('^.+@crearpsl[.]net$') &&
         !e.matches('^(nuevo|emely[.]leon|talento[.]humano|leyla[.]pasquel|leylakellypasquel)@crearpsl[.]net$'));
    }

    function profileExplicitHasAnyRole(u, roleNames) {
      let rolesList = u.get('roles', []);
      return (u.get('role', '') is string && u.get('role', '') in roleNames) ||
        (u.get('rol', '') is string && u.get('rol', '') in roleNames) ||
        (u.get('appRole', '') is string && u.get('appRole', '') in roleNames) ||
        (rolesList is list && rolesList.hasAny(roleNames));
    }

    function authedCallerHasTaskRole(targetRole) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = exists(p) ? get(p).data : {};
      return !isProfileInactive(u) && (
        hasProfileRoleFields(u)
          ? profileExplicitHasAnyRole(u, roleAliasesFor(targetRole))
          : officialRosterHasRole(targetRole)
      );
    }

    function callerHasTaskRole(roleName) {
      return isAuthenticated() && authedCallerHasTaskRole(roleName);
    }

    function authedCallerHasAnyRole(roleNames) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = exists(p) ? get(p).data : {};
      return !isProfileInactive(u) && (
        hasProfileRoleFields(u)
          ? profileExplicitHasAnyRole(u, roleNames)
          : officialRosterHasAnyRole(roleNames)
      );
    }

    function callerHasAnyRole(roleNames) {
      return isAuthenticated() && authedCallerHasAnyRole(roleNames);
    }

    function officialCoordinatorSede(addr) {
      let e = normalizedCorpEmail(addr);
      return {
        'brenda.rodriguez@crearpsl.net': 'Guayaquil',
        'diana.macas@crearpsl.net': 'Guayaquil',
        'jorge.ramirez@crearpsl.net': 'Guayaquil',
        'jorgeramirezmorejon@gmail.com': 'Guayaquil',
        'joyce.marin@crearpsl.net': 'Lima',
        'gina.cardenas@crearpsl.net': 'Lima',
        'cardenasgina29@gmail.com': 'Lima',
        'cardenaslopezgina@gmail.com': 'Lima',
        'evelyn.cedillo@crearpsl.net': 'Cuenca',
        'viviana.catota@crearpsl.net': 'Cuenca',
        'alfonso.trujillo@crearpsl.net': 'Cuenca',
        'valentina.r@crearpsl.net': 'Medellín',
        'david.gonzalez@crearpsl.net': 'Medellín',
        'naomi.campos@crearpsl.net': 'México',
        'adrianna.guarochico@crearpsl.net': 'Quito',
        'danna.guaman@crearpsl.net': 'Quito',
        'karla.pastrano@crearpsl.net': 'Quito',
        'marco.gonzalez@crearpsl.net': 'Quito',
        'katherine.aguirre@crearpsl.net': 'Quito',
        'daniela.esposito@crearpsl.net': 'Quito'
      }.get(e, '');
    }

    function isPersonalTask(taskData) {
      let emails = taskData.get('assignedToEmails', []);
      return taskData.get('isCustom', false) == true ||
        (taskData.get('id', '') is string && taskData.get('id', '').matches('custom_.*')) ||
        hasNonEmptyStr(taskData, 'assignedToEmail') ||
        (emails is list && emails.size() > 0) ||
        hasNonEmptyStr(taskData, 'assigned_to') ||
        hasNonEmptyStr(taskData, 'ownerId') ||
        hasNonEmptyStr(taskData, 'assignedByEmail') ||
        hasNonEmptyStr(taskData, 'createdBy') ||
        hasNonEmptyStr(taskData, 'createdByEmail') ||
        hasNonEmptyStr(taskData, 'created_by');
    }

    function isKnownChecklistTaskIdForRole(taskId, roleName) {
      return taskId is string && (
        (roleName == 'capitan' && (
          taskId.matches('soar_14|soar_19') ||
          taskId.matches('cap_chk_([1-9]|[1-4][0-9]|5[0-7])')
        )) ||
        (roleName == 'coord_c1' && (
          taskId.matches('cc1y2_pre1|cc1y2_pre1_b|cc1y2_pre2|cc1y2_pre3|cc1y2_pre4|cc1y2_rutina_diaria|soar_12|soar_13|cc1y2_c1_1|cc1y2_c1_2|cc1y2_c1_3|cc1y2_c1_4|cc1y2_c1_5|cc1y2_c1_6|cc1y2_c1_7|cc1y2_c1_8|soar_18|cc1y2_post1|cc1y2_post2|cc1y2_post3|cc1y2_post4|soar_21|cc1y2_c2_1|cc1y2_c2_1_b|cc1y2_c2_2|cc1y2_c2_3|cc1y2_c2_4|cc1y2_c2_5|sala_ent_c1_1|sala_ent_c1_2|sala_ent_c1_3|sala_ent_c1_4|sala_ent_c1_5|sala_ent_c1_6|sala_ent_c2_1|sala_ent_c2_2|sala_ent_c2_3|sala_ent_c2_4|sala_ent_c2_5|sala_ent_c2_6|sala_pc_c1_1|sala_pc_c1_2|sala_pc_c1_3|sala_pc_c1_4|sala_pc_c1_5|sala_pc_c1_6|sala_pc_c1_7|sala_pc_c2_1|sala_pc_c2_2|sala_pc_c2_3|sala_pc_c2_4|sala_pc_c2_5|sala_pc_c2_6|sala_pc_c2_7|sala_proy_c1_1|sala_proy_c1_2|sala_proy_c1_3|sala_proy_c1_4|sala_proy_c1_5|sala_proy_c2_1|sala_proy_c2_2|sala_proy_c2_3|sala_proy_c2_4|sala_proy_c2_5|sala_son_c1_1|sala_son_c1_2|sala_son_c1_3|sala_son_c1_4|sala_son_c1_5|sala_son_c1_6|sala_son_c1_7|sala_son_c2_1|sala_son_c2_2|sala_son_c2_3|sala_son_c2_4|sala_son_c2_5|sala_son_c2_6|sala_son_c2_7|sala_std_c1_1|sala_std_c1_2|sala_std_c1_3|sala_std_c1_4|sala_std_c1_5|sala_std_c1_6|sala_std_c1_7|sala_std_c1_8|sala_std_c1_9|sala_std_c2_1|sala_std_c2_2|sala_std_c2_3|sala_std_c2_4|sala_std_c2_5|sala_std_c2_6|sala_std_c2_7|sala_std_c2_8|sala_std_c2_9|sala_equipo_c1_1|sala_equipo_c1_2|sala_equipo_c1_3|sala_equipo_c1_4|sala_equipo_c1_5|sala_equipo_c1_6|sala_equipo_c1_7|sala_equipo_c1_8|sala_equipo_c2_1|sala_equipo_c2_2|sala_equipo_c2_3|sala_equipo_c2_4|sala_equipo_c2_5|sala_equipo_c2_6|sala_equipo_c2_7|sala_alim_c1_1|sala_alim_c1_2|sala_alim_c1_3|sala_alim_c1_4|sala_alim_c1_5|sala_alim_c1_6|sala_alim_c2_1|sala_alim_c2_2|sala_alim_c2_3|sala_alim_c2_4|sala_alim_c2_5|sala_alim_c2_6|sala_seg_c1_1|sala_seg_c1_2|sala_seg_c1_3|sala_seg_c1_4|sala_seg_c1_5|sala_seg_c1_6|sala_seg_c1_7|sala_seg_c1_8|sala_seg_c1_9|sala_seg_c2_1|sala_seg_c2_2|sala_seg_c2_3|sala_seg_c2_4|sala_seg_c2_5|sala_seg_c2_6|sala_seg_c2_7|sala_seg_c2_8|c1v2_th_1|c1v2_th_2|c1v2_th_3|c1v2_th_4|c1v2_th_5|c1v2_th_6|c1v2_th_7|c1v2_vi_1|c1v2_vi_2|c1v2_vi_3|c1v2_vi_4|c1v2_vi_5|c1v2_vi_6|c1v2_vi_7|c1v2_vi_8|c1v2_sa_1|c1v2_sa_2|c1v2_sa_3|c1v2_sa_4|c1v2_sa_5|c1v2_sa_6|c1v2_do_1|c1v2_do_2|c1v2_do_3|c1v2_do_4|c1v2_do_5|c1v2_do_6|c2v2_mi_1|c2v2_mi_2|c2v2_mi_4|c2v2_ju_1|c2v2_ju_2|c2v2_ju_3|c2v2_ju_4|c2v2_ju_5|c2v2_ju_6|c2v2_ju_7|c2v2_vi_1|c2v2_vi_2|c2v2_vi_3|c2v2_vi_4|c2v2_vi_5|c2v2_vi_6|c2v2_sa_1|c2v2_sa_2|c2v2_sa_3|c2v2_sa_4|c2v2_do_1|c2v2_do_2|c2v2_do_3') ||
          taskId.matches('cc1_chk_([1-9]|[1-4][0-9]|5[0-2])')
        )) ||
        (roleName == 'coord_maestria' && (
          taskId.matches('soar_24|soar_26|cmj_pre1|cmj_pre2|cmj_pre3|cmj_pre4|cmj_pre5|soar_28|soar_30|sala_ent_mj_1|sala_ent_mj_2|sala_ent_mj_3|sala_ent_mj_4|sala_ent_mj_5|sala_ent_mj_6|sala_pc_mj_1|sala_pc_mj_2|sala_pc_mj_3|sala_pc_mj_4|sala_pc_mj_5|sala_pc_mj_6|sala_pc_mj_7|sala_proy_mj_1|sala_proy_mj_2|sala_proy_mj_3|sala_proy_mj_4|sala_proy_mj_5|sala_son_mj_1|sala_son_mj_2|sala_son_mj_3|sala_son_mj_4|sala_son_mj_5|sala_son_mj_6|sala_son_mj_7|sala_std_mj_1|sala_std_mj_2|sala_std_mj_3|sala_std_mj_4|sala_std_mj_5|sala_std_mj_6|sala_std_mj_7|sala_std_mj_8|sala_std_mj_9|sala_equipo_mj_1|sala_equipo_mj_2|sala_equipo_mj_3|sala_equipo_mj_4|sala_equipo_mj_5|sala_equipo_mj_6|sala_seg_mj_1|sala_seg_mj_2|sala_seg_mj_3|sala_seg_mj_4|sala_seg_mj_5|sala_seg_mj_6|sala_seg_mj_7|c2v2_mi_3|cmjv2_sem_1|cmjv2_sem_2|cmjv2_sem_3|cmjv2_sem_4|cmjv2_sem_5|cmjv2_f1_1|cmjv2_f1_2|cmjv2_f1_3|cmjv2_f1_4|cmjv2_f1_5|cmjv2_f1_6|cmjv2_f2_1|cmjv2_f2_2|cmjv2_f3_1|cmjv2_f3_2|cmjv2_f3_3|cmjv2_f3_4|cmjv2_f3_5|cmjv2_f4_1|cmjv2_f4_2|cmjv2_f4_3|cmjv2_f4_4|cmjv2_f4_5|cmjv2_f4_6|cmjv2_f4_7|cmjv2_f4_8|cmjv2_f4_9|cmjv2_f4_10|cmjv2_f4_11|cmjv2_f4_12|cmj_prec1_1|cmj_prec1_2|cmj_prec1_3|cmj_prec1_4|cmj_prec1_5|cmj_prec1_6|cmj_prec1_7|cmj_prec1_8|cmj_prec1_9|cmj_prec1_10|cmj_prec1_11|cmj_prec1_12|cmj_prec1_13|cmj_prec1_14|cmj_prec1_15|cmj_prec1_16|cmj_prec1_17|cmj_prec1_18|cmj_c1_1|cmj_c1_2|cmj_c1_3|cmj_c1_4|cmj_c1_5|cmj_c1_6|cmj_c1_7|cmj_c1_8|cmj_c1_9|cmj_postc1_1|cmj_postc1_2|cmj_postc1_3|cmj_postc1_4|cmj_postc1_5|cmj_postc1_6|cmj_postc1_7|cmj_postc1_8|cmj_postc1_9|cmj_postc1_10|cmj_postc1_11|cmj_postc1_12|cmj_postc1_13') ||
          taskId.matches('cmj_chk_([1-9]|1[0-6])')
        )) ||
        (roleName == 'director_maestria' && taskId.matches('dir_m_1|dir_m_2|dir_m_3')) ||
        (roleName == 'entrenador' && taskId.matches('coach_1|coach_2|coach_3|coach_4|coach_5')) ||
        (roleName == 'entrenador_llamadas' && taskId.matches('coach_ll_1|coach_ll_2|coach_ll_3|coach_ll_4')) ||
        (roleName == 'gerente' && (
          taskId.matches('soar_1|soar_2|soar_3|soar_4|soar_5|soar_6|soar_7|soar_8|soar_9|soar_10|soar_11|soar_16|soar_17|soar_20|soar_22|soar_23|soar_25|soar_27|soar_29|gerente_post_mj_1') ||
          taskId.matches('ger_chk_([1-9]|[1-5][0-9]|60)')
        )) ||
        (roleName == 'manager' && taskId.matches('mngr_1|mngr_2|mngr_3')) ||
        (roleName == 'qt' && (
          taskId.matches('soar_15') ||
          taskId.matches('qt_chk_([1-9]|[1-3][0-9]|4[0-4])')
        ))
      );
    }

    function isReservedChecklistTaskId(taskId) {
      return taskId is string && (
        taskId.matches('soar_[0-9]+') || taskId.matches('gerente_[A-Za-z0-9_]+') ||
        taskId.matches('cc1y2_[A-Za-z0-9_]+') || taskId.matches('sala_[A-Za-z0-9_]+') ||
        taskId.matches('c1v2_[A-Za-z0-9_]+') || taskId.matches('c2v2_[A-Za-z0-9_]+') ||
        taskId.matches('cmj_[A-Za-z0-9_]+') || taskId.matches('cmjv2_[A-Za-z0-9_]+') ||
        taskId.matches('cap_chk_[0-9]+') || taskId.matches('cc1_chk_[0-9]+') ||
        taskId.matches('cmj_chk_[0-9]+') || taskId.matches('ger_chk_[0-9]+') ||
        taskId.matches('qt_chk_[0-9]+') ||
        taskId.matches('coach_[0-9]+') || taskId.matches('coach_ll_[0-9]+') ||
        taskId.matches('dir_[A-Za-z0-9_]+') || taskId.matches('mngr_[A-Za-z0-9_]+')
      );
    }

    function isChecklistCatalogTask(taskData, personalTask) {
      let taskRole = taskData.get('role', '');
      return isAuthenticated() &&
        taskData.get('isCustom', false) != true &&
        !personalTask &&
        taskRole is string &&
        callerHasTaskRole(taskRole) &&
        isKnownChecklistTaskIdForRole(taskData.get('id', ''), taskRole);
    }

    function hasExplicitProfileAnyRole(roleNames) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = isAuthenticated() && exists(p) ? get(p).data : {};
      return isAuthenticated() && !isProfileInactive(u) && profileExplicitHasAnyRole(u, roleNames);
    }

    function pendingCollabMatches(p, i, callerEmails) {
      let item = p.size() > i && p[i] is map ? p[i] : {};
      let em = item.get('email', '');
      return em is string && em != '' && em.lower() in callerEmails;
    }

    function hasPendingCollabWithAliases(resourceData, callerEmails) {
      let p = resourceData.get('pendingCollaborations', []);
      return isAuthenticated() && p is list && (
        pendingCollabMatches(p, 0, callerEmails) ||
        pendingCollabMatches(p, 1, callerEmails) ||
        pendingCollabMatches(p, 2, callerEmails)
      );
    }

    function canReadTaskWithContext(taskData, aliases, owner, collab) {
      let personalTask = isPersonalTask(taskData);
      return isTaskRecipientWithAliases(taskData, aliases) ||
        owner ||
        (!personalTask && (
          isGerenteODireccion() ||
          collab ||
          hasPendingCollabWithAliases(taskData, aliases) ||
          isChecklistCatalogTask(taskData, personalTask) ||
          (taskData.get('isValidation', false) == true &&
           hasExplicitProfileAnyRole(['gerente', 'direccion']))
        ));
    }

    function canReadTask(taskData) {
      let aliases = callerEmailAliases();
      return canReadTaskWithContext(
        taskData,
        aliases,
        isOwnerWithAliases(taskData, aliases),
        isCollaboratorWithAliases(taskData, aliases)
      );
    }

    function authedCanReadDualTask(taskData) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = exists(p) ? get(p).data : {};
      let callerSede = hasNonEmptyStr(u, 'sede') ? u.sede : officialCoordinatorSede(email());
      return !isPersonalTask(taskData) &&
        taskData.get('isDualTask', false) == true &&
        (isGerenteODireccion() ||
         (!isProfileInactive(u) &&
          (hasProfileRoleFields(u)
            ? profileExplicitHasAnyRole(u, ['manager', 'entrenador', 'coach', 'entrenador_llamadas'])
            : officialRosterHasAnyRole(['entrenador', 'entrenador_llamadas'])))) &&
        (
          taskData.get('sede', '') == 'Global' ||
          taskData.get('sede', '') == 'Sede Global' ||
          taskData.get('sede', '') == callerSede
        );
    }

    function canReadDualTask(taskData) {
      return isAuthenticated() && authedCanReadDualTask(taskData);
    }

    function isOperationalProgressUpdate() {
      return isAuthenticated() &&
        (request.resource.data.get('isCustom', false) != true ||
         resource.data.get('isCustom', false) == true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completed', 'status', 'completions', 'progress', 'progressPercentage',
          'evidence_url', 'evidenceUrl', 'date', 'googleSynced',
          'assigneeProgress', 'evidences', 'comments', 'notes', 'description',
          'progressNotes', 'completedAt', 'lastUpdated', 'lastUpdatedBy',
          'updatedAt', 'updated_at', 'deadline', 'lifecycleMutation', 'closedAssigneeKeys',
          'hasManualDeadline', 'isManualDeadline', 'manualDeadline',
          'pendingCollaborations', 'collaborators', 'collaboratorDetails',
          'catalogTask', 'isCustom'
        ]);
    }

    function lifecycleClosed(data) {
      return data.get('completed', false) == true || data.get('status', '') == 'Completada' ||
        data.get('progress', 0) == 100 || data.get('progressPercentage', 0) == 100;
    }

    function participantBeforeState(taskId, key, taskData) {
      let path = /databases/$(database)/documents/tasks/$(taskId)/participant_states/$(key);
      let ap = taskData.get('assigneeProgress', {});
      return exists(path) ? get(path).data.state : (ap is map && ap.get(key, {}) is map ? ap.get(key, {}) : {});
    }

    function participantAfterState(taskId, key, taskData) {
      let path = /databases/$(database)/documents/tasks/$(taskId)/participant_states/$(key);
      let ap = taskData.get('assigneeProgress', {});
      return existsAfter(path) ? getAfter(path).data.state : (ap is map && ap.get(key, {}) is map ? ap.get(key, {}) : {});
    }

    function lifecycleEventState(taskId, taskData, scope, after) {
      let comp = taskData.get('completions', {});
      let compKey = scope.get('sede', '') + '__' + scope.get('cycleId', '');
      return scope.keys().hasAll(['sede', 'cycleId'])
        ? (comp is map && comp.get(compKey, {}) is map ? comp.get(compKey, {}) : {})
        : scope.keys().hasAll(['assigneeEmail'])
          ? (after ? participantAfterState(taskId, scope.assigneeEmail, taskData)
             : participantBeforeState(taskId, scope.assigneeEmail, taskData))
          : taskData;
    }

    function hasNewLifecycleEvent(taskId, mutation, action) {
      let eventId = mutation.get('eventId', '');
      let eventPath = /databases/$(database)/documents/task_completion_events/$(eventId);
      let event = eventId is string && eventId != '' && existsAfter(eventPath) ? getAfter(eventPath).data : {};
      return eventId is string && eventId != '' && !exists(eventPath) &&
        event.get('taskId', '') == taskId && event.get('action', '') == action &&
        event.get('actorEmail', '') == email() && event.get('source', '') == 'manual' &&
        event.get('occurredAt', null) == request.time &&
        event.get('scope', {}) == mutation.get('scope', {});
    }

    function hasNewReopenEvent(taskId, mutation) {
      return hasNewLifecycleEvent(taskId, mutation, 'reopened');
    }

    function preservesClosedEntry(before, after) {
      return !lifecycleClosed(before) ||
        (lifecycleClosed(after) &&
         (before.get('completed', false) != true || after.get('completed', false) == true) &&
         (before.get('status', '') != 'Completada' || after.get('status', '') == 'Completada') &&
         after.get('completedAt', null) == before.get('completedAt', null) &&
         (before.get('progress', 0) != 100 || after.get('progress', 0) == 100) &&
         (before.get('progressPercentage', 0) != 100 || after.get('progressPercentage', 0) == 100));
    }

    function safeChangedLifecycleMap(before, after, scope, field, taskId, mutation) {
      let key = field == 'completions'
        ? scope.get('sede', '') + '__' + scope.get('cycleId', '')
        : scope.get('assigneeEmail', '');
      let validScope = field == 'completions'
        ? scope.keys().hasAll(['sede', 'cycleId']) && scope.sede != '' && scope.cycleId != ''
        : scope.keys().hasAll(['assigneeEmail']) && scope.assigneeEmail != '';
      let bEntry = before.get(key, {}) is map ? before.get(key, {}) : {};
      let aEntry = after.get(key, {}) is map ? after.get(key, {}) : {};
      return validScope && after.diff(before).affectedKeys().hasOnly([key]) &&
          (preservesClosedEntry(bEntry, aEntry) ||
           (!lifecycleClosed(aEntry) && scope == mutation.get('scope', {}) &&
            hasNewReopenEvent(taskId, mutation)));
    }

    function safeLifecycleMap(before, after, scope, field, taskId, mutation) {
      return before == after ||
        (after.diff(before).changedKeys().size() == 0 && after.diff(before).removedKeys().size() == 0) ||
        safeChangedLifecycleMap(before, after, scope, field, taskId, mutation);
    }

    function isTaskParticipant(taskData, key, pk, owner) {
      let keyAliases = emailAliases(key);
      let assignedToEmail = taskData.get('assignedToEmail', '');
      let assignedTo = taskData.get('assigned_to', '');
      let assignedToEmails = taskData.get('assignedToEmails', []);
      let collaborators = taskData.get('collaborators', []);
      let ap = taskData.get('assigneeProgress', {});
      return (ap is map && key in ap) ||
        (assignedToEmails is list && (key in assignedToEmails || assignedToEmails.hasAny(keyAliases))) ||
        key == assignedToEmail ||
        (assignedToEmail is string && assignedToEmail != '' && pk == participantEmail(assignedToEmail)) ||
        key == assignedTo ||
        (assignedTo is string && assignedTo != '' && pk == participantEmail(assignedTo)) ||
        (collaborators is list && (key in collaborators || collaborators.hasAny(keyAliases))) ||
        (pk == participantEmail(email()) && owner);
    }

    function validParticipantState(taskId, key, taskData, before) {
      let data = request.resource.data;
      let callerAliases = callerEmailAliases();
      let owner = isOwnerWithAliases(taskData, callerAliases);
      let collab = isCollaboratorWithAliases(taskData, callerAliases);
      let pk = participantEmail(key);
      let rawMut = data.get('lifecycleMutation', {});
      let mutMap = rawMut is map ? rawMut : {};
      let mutation = { 'eventId': mutMap.get('eventId', ''),
        'scope': { 'assigneeEmail': key } };
      return canReadTaskWithContext(taskData, callerAliases, owner, collab) &&
        isTaskParticipant(taskData, key, pk, owner) &&
        data.keys().hasAll(['taskId', 'assigneeEmail', 'state', 'lifecycleMutation']) &&
        data.keys().hasOnly(['taskId', 'assigneeEmail', 'state', 'lifecycleMutation']) &&
        data.taskId == taskId && data.assigneeEmail == key && data.state is map &&
        (data.state == before || pk == participantEmail(email()) || isGerenteODireccion() || owner || collab) &&
        (preservesClosedEntry(before, data.state) ||
          (!lifecycleClosed(data.state) && hasNewReopenEvent(taskId, mutation))) &&
        (lifecycleClosed(before) || !lifecycleClosed(data.state) ||
          hasNewLifecycleEvent(taskId, mutation, 'completed'));
    }

    function validParticipantStateCreate(taskId, key) {
      let taskData = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      let ap = taskData.get('assigneeProgress', {});
      let before = ap is map && ap.get(key, {}) is map ? ap.get(key, {}) : {};
      return validParticipantState(taskId, key, taskData, before);
    }

    function validParticipantStateUpdate(taskId, key) {
      let taskData = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return validParticipantState(taskId, key, taskData, resource.data.state);
    }

    function safeTaskLifecycleUpdate(taskId) {
      let before = resource.data;
      let after = request.resource.data;
      let rawMutation = after.get('lifecycleMutation', {});
      let mutation = rawMutation is map ? rawMutation : {};
      let rawScope = mutation.get('mapScope', mutation.get('scope', {}));
      let scope = rawScope is map ? rawScope : {};
      let beforeCompletions = before.get('completions', {}) is map ? before.get('completions', {}) : {};
      let afterCompletions = after.get('completions', {}) is map ? after.get('completions', {}) : {};
      let beforeAssignees = before.get('assigneeProgress', {}) is map ? before.get('assigneeProgress', {}) : {};
      let afterAssignees = after.get('assigneeProgress', {}) is map ? after.get('assigneeProgress', {}) : {};
      return (preservesClosedEntry(before, after) ||
          (!lifecycleClosed(after) && hasNewReopenEvent(taskId, {
            'eventId': mutation.get('eventId', ''), 'scope': {}
          }))) &&
        safeLifecycleMap(beforeCompletions, afterCompletions,
          scope, 'completions', taskId, mutation) &&
        afterAssignees == beforeAssignees;
    }

    function validClosureContext(event, taskData) {
      let rawContext = event.get('closureContext', {});
      let context = rawContext is map ? rawContext : {};
      let rawComments = taskData.get('comments', '');
      let taskComments = rawComments == null ? '' : rawComments;
      let rawEvUrl = taskData.get('evidenceUrl', null);
      let rawEvUrlLegacy = taskData.get('evidence_url', '');
      let taskEvUrl = rawEvUrl != null ? rawEvUrl : (rawEvUrlLegacy == null ? '' : rawEvUrlLegacy);
      let rawEvidences = taskData.get('evidences', []);
      let taskEvidences = rawEvidences == null ? [] : rawEvidences;
      return context.keys().hasAll(['comments', 'evidenceUrl', 'evidences']) &&
        context.keys().hasOnly(['comments', 'evidenceUrl', 'evidences']) &&
        context.comments is string && context.comments.size() <= 500000 &&
        context.comments == taskComments &&
        context.evidenceUrl is string && context.evidenceUrl.size() <= 8192 &&
        context.evidenceUrl == taskEvUrl &&
        context.evidences is list && context.evidences.size() <= 100 &&
        context.evidences == taskEvidences;
    }

    function validTaskCompletionEvent() {
      let event = request.resource.data;
      let taskPath = /databases/$(database)/documents/tasks/$(event.taskId);
      let beforeTask = exists(taskPath) ? get(taskPath).data : {};
      let afterTask = existsAfter(taskPath) ? getAfter(taskPath).data : {};
      let scope = event.get('scope', {});
      let beforeState = lifecycleEventState(event.taskId, beforeTask, scope, false);
      let afterState = lifecycleEventState(event.taskId, afterTask, scope, true);
      return event.keys().hasAll(['taskId', 'action', 'actorEmail', 'occurredAt', 'source', 'scope']) &&
        event.keys().hasOnly(['taskId', 'action', 'actorEmail', 'occurredAt', 'source', 'scope', 'closureContext']) &&
        event.taskId is string && event.taskId.size() > 0 &&
        event.actorEmail == email() &&
        event.occurredAt == request.time &&
        event.source == 'manual' &&
        event.scope is map &&
        (scope.size() == 0 ||
          (scope.keys().hasOnly(['sede', 'cycleId']) &&
           scope.sede is string && scope.sede.size() > 0 &&
           scope.cycleId is string && scope.cycleId.size() > 0) ||
          (scope.keys().hasOnly(['assigneeEmail']) && scope.assigneeEmail is string &&
            (participantEmail(scope.assigneeEmail) == participantEmail(email()) || isSuperAdmin() || isGerenteODireccion() ||
             emailIsCaller(beforeTask.get('createdBy', '')) || emailIsCaller(beforeTask.get('assignedByEmail', ''))))) &&
        existsAfter(taskPath) &&
        (event.action == 'completed' ? validClosureContext(event, afterTask) :
          !event.keys().hasAny(['closureContext'])) &&
        ((event.action == 'completed' && !lifecycleClosed(beforeState) && lifecycleClosed(afterState)) ||
         (event.action == 'reopened' && lifecycleClosed(beforeState) && !lifecycleClosed(afterState)));
    }

    function callerRole() {
      return callerHasTaskRole('coord_maestria') || callerHasTaskRole('director_maestria');
    }

    // HOJA EN BLANCO: Funciones de transversalidad
    function checkHojaEnBlancoAccess(docData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'entrenador' && (
              docData.get('assignedToEmail', '') == email() || 
              (docData.keys().hasAll(['assignedToEmails']) && email() in docData.assignedToEmails) ||
              docData.get('entrenadorEmail', '') == email() ||
              (docData.keys().hasAll(['entrenadores']) && email() in docData.entrenadores) ||
              docData.get('email', '') == email() ||
              docData.get('autorEmail', '') == email() ||
              docData.get('registradoPorEmail', '') == email()
            )) ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'entrenador' && 
             docData.get('sede', '') != '' && docData.get('sede', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sede)
          )
        )
      );
    }

    function canReadHojaEnBlanco() {
      return checkHojaEnBlancoAccess(resource.data);
    }
    
    function canWriteHojaEnBlanco() {
      return (request.resource == null && resource != null && checkHojaEnBlancoAccess(resource.data)) ||
             (request.resource != null && resource == null && checkHojaEnBlancoAccess(request.resource.data)) ||
             (request.resource != null && resource != null && checkHojaEnBlancoAccess(resource.data) && checkHojaEnBlancoAccess(request.resource.data));
    }

    // MJ_CALENDARS (29/08/2026): calendarios de Maestría del Juego por equipo
    // (CalendarioMJ.jsx), pedido por José a partir de 3 PDF de ejemplo reales.
    // Confirmado explícitamente por José antes de tocar firestore.rules.
    match /mj_calendars/{calendarId} {
      allow read, write: if isAuthenticated();
    }

    // C-01: tareas críticas/masivas solo las crean SuperAdmin o perfiles gerenciales verificados.
    // Los documentos con forma de catálogo (isChecklistCatalogTask) se aceptan antes, sin verificar perfil.
    function hasVerifiedTaskAdminProfile() {
      return callerHasAnyRole(['gerente', 'direccion', 'director_maestria', 'cfo', 'cco', 'ceo', 'socio']);
    }

    function requiresTaskAdminForCreate(taskData) {
      return (taskData.get('isCritical', false) == true ||
              taskData.get('priority', '') == '🔴 ROJO' ||
              (taskData.get('assignedToEmails', []) is list &&
               taskData.get('assignedToEmails', []).size() > 1));
    }

    function canCreateTask(taskData) {
      let personalTask = isPersonalTask(taskData);
      let aliases = callerEmailAliases();
      return (taskData.get('isCustom', false) != true &&
              isChecklistCatalogTask(taskData, personalTask)) ||
        (requiresTaskAdminForCreate(taskData)
          ? (isGerenteODireccion() || hasVerifiedTaskAdminProfile())
          : (isGerenteODireccion() ||
             (isOwnerWithAliases(taskData, aliases) &&
              !isReservedChecklistTaskId(taskData.get('id', ''))) ||
             isCollaboratorWithAliases(taskData, aliases)));
    }

    function canAcceptTaskCollaboration(before, after, personalTask, aliases) {
      let prevCollabs = before.get('collaborators', []);
      return !personalTask &&
        after.diff(before).affectedKeys().hasOnly(['collaborators', 'collaboratorDetails', 'updatedAt']) &&
        isCollaboratorWithAliases(after, aliases) &&
        (!(prevCollabs is list) || after.collaborators.hasAll(prevCollabs));
    }

    function canUpdateTask(taskId) {
      let before = resource.data;
      let after = request.resource.data;
      let personalTask = isPersonalTask(before);
      let aliases = callerEmailAliases();
      let opUpdate = isOperationalProgressUpdate();
      return safeTaskLifecycleUpdate(taskId) && (
        (before.get('isCustom', false) != true &&
         isChecklistCatalogTask(before, personalTask) &&
         opUpdate) ||
        isGerenteODireccion() ||
        isOwnerWithAliases(before, aliases) ||
        isTaskRecipientWithAliases(before, aliases) ||
        (isCollaboratorWithAliases(before, aliases) && opUpdate) ||
        canAcceptTaskCollaboration(before, after, personalTask, aliases)
      );
    }

    // TASKS
    match /tasks/{taskId} {
      allow read: if canReadTask(resource.data);
      allow create: if canCreateTask(request.resource.data);
      allow update: if canUpdateTask(taskId);
      allow delete: if isGerenteODireccion() || isSuperAdmin();

      match /participant_states/{assigneeEmail} {
        allow read: if canReadTask(get(/databases/$(database)/documents/tasks/$(taskId)).data);
        allow create: if validParticipantStateCreate(taskId, assigneeEmail);
        allow update: if validParticipantStateUpdate(taskId, assigneeEmail);
        allow delete: if false;
      }
    }

    match /task_completion_events/{eventId} {
      allow read: if isAuthenticated() &&
        (resource.data.actorEmail == email() || isSuperAdmin() || isGerenteODireccion());
      allow create: if isAuthenticated() && validTaskCompletionEvent();
      allow update, delete: if false;
    }

    // GOALS
    match /goals/{goalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // igual que antes: sin restringir por rol
      allow update: if isSuperAdmin() || isGerenteODireccion() || isOwner(resource.data) ||
        (callerHasAnyRole(['coord_c1', 'coord_c2', 'coordinador_c1', 'coordinador_c1c2', 'coord_c1_c2', 'coord_maestria', 'coordinador_mj', 'coordinador_maestria', 'coord_jr', 'coordinador']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedCoordinators', 'currentValue', 'progress', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    function isReportAdmin() {
      return isSuperAdmin() || callerHasTaskRole('direccion');
    }

    function reportSedeName(value) {
      let sede = value.lower();
      return sede in ['lima', 'lim', 'sede-lima-01'] ? 'Lima' :
        sede in ['quito', 'uio', 'uio c1', 'uio c2', 'uioc1', 'uioc2'] ? 'Quito' :
        sede in ['cuenca', 'cue'] ? 'Cuenca' :
        sede in ['méxico', 'mexico', 'mex', 'cdmx'] ? 'México' :
        sede in ['guayaquil', 'gye'] ? 'Guayaquil' :
        sede in ['medellín', 'medellin', 'med'] ? 'Medellín' : value;
    }

    function authedReportScopeAllowed(data) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = exists(p) ? get(p).data : {};
      let e = normalizedCorpEmail(email());
      let hasRoles = hasProfileRoleFields(profile);
      let rawSede = hasNonEmptyStr(profile, 'sede') ? profile.sede : officialCoordinatorSede(e);
      let stage = data.get('stage', '');
      return isSuperAdmin() || (!isProfileInactive(profile) && (
        (hasRoles ? profileExplicitHasAnyRole(profile, roleAliasesFor('direccion')) : rosterDireccion(e)) ||
        (reportSedeName(rawSede) == data.get('sede', '') && (
          hasRoles
            ? ((stage == 'C1' && profileExplicitHasAnyRole(profile, roleAliasesFor('coord_c1'))) ||
               (stage == 'C2' && profileExplicitHasAnyRole(profile, roleAliasesFor('coord_c2'))) ||
               (stage in ['C1', 'C2'] && profileExplicitHasAnyRole(profile, roleAliasesFor('coordinador_c1c2'))) ||
               profileExplicitHasAnyRole(profile, roleAliasesFor('gerente')))
            : ((stage == 'C1' && rosterCoordC1(e)) || rosterGerente(e))
        ))
      ));
    }

    function reportScopeAllowed(data) {
      return isAuthenticated() && authedReportScopeAllowed(data);
    }

    match /nodus_report_sources/{sourceId} {
      allow read: if isAuthenticated() && reportScopeAllowed(resource.data);
      allow write: if false;
    }

    // REPORTS
    match /reports/{reportId} {
      allow read: if isAuthenticated() &&
        (resource.data.type != 'Llamadas' || reportScopeAllowed(resource.data));
      allow create: if isAuthenticated() &&
        (request.resource.data.get('type', '') != 'Llamadas' ||
         (reportScopeAllowed(request.resource.data) &&
          request.resource.data.get('stage', '') in ['C1', 'C2'] &&
          request.resource.data.get('submitted_by_email', '').lower() == email() &&
          request.resource.data.get('team_number', '') is string &&
          request.resource.data.get('team_number', '').matches('[1-9][0-9]*') &&
          request.resource.data.get('source', '') in ['nodus-reviewed', 'manual-reviewed']));
      allow update: if (isGerenteODireccion() || isSuperAdmin()) &&
        (resource.data.get('type', '') != 'Llamadas' ||
         (reportScopeAllowed(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sede', 'stage', 'type', 'submitted_by_email', 'team_number'])));
      allow delete: if (isGerenteODireccion() || isSuperAdmin()) &&
        (resource.data.get('type', '') != 'Llamadas' || reportScopeAllowed(resource.data));
    }

    // USER PROFILES (registro de ├║ltimo login / conexi├│n, doc ID = correo)
    match /user_profiles/{userDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && email() == userDocId;
    }

    function isValidNotificationData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'title', 'message', 'read', 'created_at'])
        && data.keys().hasOnly(['userId', 'title', 'message', 'read', 'created_at',
             'createdAt', 'timestamp', 'type', 'taskId', 'taskMessageId', 'taskTitle', 'inviterEmail',
             'inviterName', 'sede', 'standardId', 'priority', 'requiresAction', 'communicationId', 'robot_token'])
        && data.userId is string
        && data.userId.matches('.+@.+')
        && data.title is string && data.title.size() <= 1000
        && data.message is string && data.message.size() <= 20000
        && data.read == false
        && data.created_at is string;
    }

    // NOTIFICATIONS (userId siempre es el correo, nunca el uid)
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == email() || isSuperAdmin());
      // TRADEOFF: los productores (ChecklistContext, PortfolioBoard, ComunicadosOperativos,
      // scheduleGovernanceAgent, ExcellenceService) escriben desde el cliente a OTROS
      // destinatarios y no registran remitente verificable, así que Rules no puede validar
      // remitente->destinatario. Se limita al máximo: solo esquema conocido, sin leídas,
      // textos acotados. El destinatario es el único que puede leer/actualizar/borrar.
      // Automatizaciones con robot_token DEBEN cumplir estrictamente el esquema para evitar abusos.
      allow create: if isValidNotificationData() && (
        isAuthenticated() ||
        (request.resource.data != null && request.resource.data.get('robot_token', '') == "NODUS_ROBOT_CPSL_2026_SECRET")
      );
      allow update: if isAuthenticated() && (resource.data.userId == email() || emailIsCaller(resource.data.get('userId', '')));
      allow delete: if isAuthenticated() && (resource.data.userId == email() || emailIsCaller(resource.data.get('userId', '')));
    }

    // VENUES (sede, hotel, sal├│n)
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // CYCLES
    match /cycles/{cycleId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // MAIL (cola de la extensión Trigger Email)
    match /mail/{mailId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() || (request.resource.data != null && request.resource.data.get('robot_token', '') == "NODUS_ROBOT_CPSL_2026_SECRET"))
        && request.resource.data.keys().hasAny(['to', 'message', 'template']);
      allow update, delete: if isSuperAdmin();
    }

    // HORARIOS Y TURNOS DE ENTRENAMIENTO (Causa OS)
    match /nodus_training_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // USERS
    // Los campos de rol y estado solo los pueden modificar SuperAdmins.
    // Los usuarios pueden mantener sus datos de perfil y elegir una vista entre
    // los roles que ya tienen asignados, sin poder ampliar esos roles.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == userId ||
          (request.resource.data != null && (
            request.resource.data.get('email', '') == email() ||
            (request.resource.data.get('emails', []) is list && email() in request.resource.data.get('emails', [])) ||
            request.resource.data.get('uid', '') == request.auth.uid
          ))
        )
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == userId ||
          (resource != null && (
            resource.data.get('email', '') == email() ||
            (resource.data.get('emails', []) is list && email() in request.resource.data.get('emails', [])) ||
            resource.data.get('uid', '') == request.auth.uid
          ))
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isSuperAdmin', 'isActive', 'status', 'active', 'rolesUpdatedBy', 'rolesUpdatedAt',
          'role', 'rol', 'appRole', 'roles', 'sede', 'roleSedes'
        ])
      );
      allow delete: if isSuperAdmin();

      match /copilot_chats/{chatId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
    }
    match /trainer_coherence_log/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          'action', 'managerDocId', 'trainerDocId', 'before', 'after', 'actorEmail', 'occurredAt'
        ])
        && request.resource.data.action == 'repair_trainer_label'
        && request.resource.data.actorEmail == email()
        && request.resource.data.occurredAt == request.time
        && request.resource.data.managerDocId is string
        && request.resource.data.trainerDocId is string
        && request.resource.data.before is string
        && request.resource.data.after is string;
      allow update, delete: if false;
    }

    // ASIGNADOR OFICIAL DE ENTRENADORES. La pantalla guarda confirmaciones
    // separadas del calendario fuente y un log inmutable. Solo las personas
    // autorizadas pueden modificar la asignación; nadie puede borrar la
    // trazabilidad desde el cliente.
    function canManageTrainerAssignments() {
      return isAuthenticated() && (
        isGerenteODireccion() ||
        isSuperAdmin() ||
        email() in [
          'jose.sanchez@crearpsl.net',
          'fer.aragon@crearpsl.net',
          'fer.aragon@crearpsl.com',
          'paul.sosa@crearpsl.net',
          'andres.gomez@crearpsl.net',
          'gomeznueve@gmail.com',
          'daniela.monroy@crearpsl.net',
          'daniela.monroy@crearpsl.com'
        ] ||
        callerEmailAliases().hasAny([
          'daniela.monroy@crearpsl.net'
        ])
      );
    }
    match /asignaciones_entrenadores/{assignmentId} {
      allow read, create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    match /asignaciones_entrenadores_log/{logId} {
      allow read, create: if canManageTrainerAssignments();
      allow update, delete: if false;
    }
    function canSendOperationalCommunications() {
      return isAuthenticated() && email() in [
        'jose.sanchez@crearpsl.net', 'fer.aragon@crearpsl.net',
        'fer.aragon@crearpsl.com', 'paul.sosa@crearpsl.net',
        'andres.gomez@crearpsl.net', 'gomeznueve@gmail.com'
      ];
    }
    match /operational_communications/{communicationId} {
      allow read, create: if canSendOperationalCommunications();
      allow update, delete: if false;
    }

    // Conversación interna vinculada a una tarea. El mensaje es inmutable y
    // solo lo ven quien lo envió y quienes aparecen como destinatarios.
    match /task_messages/{messageId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderEmail == email() || email() in resource.data.recipientEmails);
      allow create: if isAuthenticated() &&
        request.resource.data.senderEmail == email() &&
        request.resource.data.taskId is string &&
        request.resource.data.body is string &&
        request.resource.data.recipientEmails is list;
      allow update, delete: if false;
    }
    // Proyección mínima de asignaciones confirmadas para el calendario global.
    // Solo publica nombre, evento y fecha de confirmación; nunca correos,
    // identidades de quien asignó ni la bitácora interna.
    match /calendario_asignaciones_publicas/{assignmentId} {
      allow read: if true;
      allow create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    // Calendario operativo: Causa OS conserva ajustes y nuevos eventos sin
    // alterar la hoja histórica. Los cambios se auditan de forma append-only.
    match /calendario_operativo_overrides/{eventId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }
    match /calendario_operativo_custom/{eventId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }
    match /calendario_operativo_log/{logId} {
      allow read, create: if canManageTrainerAssignments();
      allow update, delete: if false;
    }
    // Agenda publicada por el Asignador: solo fechas, sede, entrenamiento y
    // lugar que ya son visibles en los calendarios. No incluye datos de
    // usuarios ni auditoría. Permite reflejo en vivo para todos los roles.
    match /calendario_operativo_publico/{eventId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // CONTROL DE PÓLIZAS: el resultado de cada validación queda persistido
    // para no reconsultar Drive al entrar. El historial es append-only: nadie
    // puede editar ni borrar eventos de auditoría desde el cliente.
    match /trainer_policy_reviews/{reviewId} {
      allow read, create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    match /trainer_policy_audit/{auditId} {
      allow read, create: if canManageTrainerAssignments();
      allow update, delete: if false;
    }

    // NODUS: acceso gerencial/autenticado y sincronización de robots autorizados.
    // Lectura restringida a usuarios autenticados (blindaje contra scraping web anónimo).
    match /nodus_kpis_sincronizados/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion() || (request.resource.data != null && request.resource.data.get('robot_token', '') == "NODUS_ROBOT_CPSL_2026_SECRET");
    }

    // FUTUROS IMPOSIBLES: NODUS conserva la fuente; Causa OS solo consume
    // el snapshot publicado y registra las decisiones de revisión por
    // separado. El historial no puede ser alterado desde el cliente.
    match /nodus_futuros_imposibles/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    match /nodus_fi_reviews/{reviewId} {
      allow read, create, update: if isGerenteODireccion() || isSuperAdmin();
      allow delete: if false;
    }
    match /nodus_fi_audit/{auditId} {
      allow read, create: if isGerenteODireccion() || isSuperAdmin();
      allow update, delete: if false;
    }
    // Catálogo técnico sin PII, producido por el agente servidor de
    // descubrimiento. Causa OS lo lee para informar qué contrato NODUS está
    // disponible; ningún cliente puede alterarlo.
    match /nodus_source_catalog/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
    }

    // Respaldo bruto de NODUS: puede contener identificadores y contactos de
    // participantes. Solo gerencia/superadministración puede leerlo; el agente
    // lo escribe mediante Admin SDK y ningún cliente puede modificarlo.
    match /nodus_archive_runs/{runId} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
      match /pages/{pageId} {
        allow read: if isGerenteODireccion() || isSuperAdmin();
        allow write: if false;
        match /chunks/{chunkId} {
          allow read: if isGerenteODireccion() || isSuperAdmin();
          allow write: if false;
        }
      }
    }

    // Auditoría de accesos y estadísticas de cuentas NODUS: se limita la
    // lectura por contener identidades y marcas de conexión de usuarios.
    match /nodus_user_access_latest/{documentId} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
    }
    match /nodus_user_access_runs/{runId} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
      match /pages/{pageId} {
        allow read: if isGerenteODireccion() || isSuperAdmin();
        allow write: if false;
        match /chunks/{chunkId} {
          allow read: if isGerenteODireccion() || isSuperAdmin();
          allow write: if false;
        }
      }
    }

    // A-01: roles administrados en users/{uid} (nunca datos enviados por el cliente).
    function isManagementRole() {
      return isGerenteODireccion() || callerHasAnyRole([
        'gerente', 'direccion', 'cfo', 'cco', 'ceo',
        'director_maestria', 'consolidado', 'superadmin'
      ]);
    }
    function isLearningReaderRole() {
      return isManagementRole() || callerHasAnyRole([
        'coord_c1', 'coord_c2', 'coordinador_c1', 'coordinador_c1c2', 'coord_c1_c2', 'coord_jr',
        'coord_maestria', 'coordinador_mj', 'coordinador_maestria'
      ]);
    }
    function isStaffOrCoordinatorOrManagement() {
      return isAuthenticated() && (
        isGerenteODireccion() ||
        isSuperAdmin() ||
        callerHasAnyRole([
          'gerente', 'direccion', 'cfo', 'cco', 'ceo', 'director_maestria', 'consolidado', 'superadmin',
          'coord_c1', 'coord_c2', 'coordinador_c1', 'coordinador_c1c2', 'coord_c1_c2', 'coord_maestria', 'coordinador_mj', 'coordinador_maestria', 'coord_jr', 'coordinador',
          'staff', 'manager', 'capitan', 'qt', 'quantum_team', 'coord_qt', 'coordinador_qt', 'entrenador', 'coach', 'entrenador_llamadas', 'talento_humano', 'aliado'
        ])
      );
    }
    function emailIsCaller(value) {
      return value is string && value != '' && value.lower() in callerEmailAliases();
    }

    // ------------------------------------------------------------------------
    // COLECCIONES AUDITADAS CON PERMISOS AMPLIOS DE COLABORACIÓN OPERATIVA
    // ------------------------------------------------------------------------
    match /staff_directory/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /managers_directory/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /excellence_standards/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /kpi_reports/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /learning_logs/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /qt_directory/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isManagementRole();
    }
    match /success_patterns/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /sync_history/{entryId} {
      allow read, delete: if isAuthenticated() && (isManagementRole() ||
        emailIsCaller(resource.data.get('userEmail', '')));
      allow update: if isAuthenticated() && (isManagementRole() ||
        (emailIsCaller(resource.data.get('userEmail', '')) &&
         request.resource.data.get('userEmail', '') == resource.data.get('userEmail', '')));
      allow create: if isAuthenticated() && (isManagementRole() ||
        emailIsCaller(request.resource.data.get('userEmail', '')));
    }
    match /user_stats/{statsId} {
      allow read: if isAuthenticated() && (isLearningReaderRole() ||
        statsId == request.auth.uid || emailIsCaller(statsId));
      allow write: if isAuthenticated() && (isManagementRole() ||
        statsId == request.auth.uid || emailIsCaller(statsId));
    }

    // ------------------------------------------------------------------------
    // COLECCIONES ADICIONALES (FALTANTES REVELADAS EN AUDITORÍA FORENSE)
    // ------------------------------------------------------------------------
    // PROTECCIÓN DE DATOS SENSIBLES (PII): Solo staff/coordinador/management autenticado puede leer.
    // Escritura restringida estrictamente a gerencia o superadmin.
    match /participants/{document=**} {
      allow read: if isStaffOrCoordinatorOrManagement();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /crm_participants/{document=**} {
      allow read: if isStaffOrCoordinatorOrManagement();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /sugerencias_soporte/{document=**} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
    match /opt_outs/{document=**} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }
    match /recurring_tasks_templates/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /llamadas_grupales_historial/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /notas_seguimiento/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // GOBERNANZA Y CONTENCIÓN DE IA SOBRE COLECCIONES FINANCIERAS:
    // Bloqueo total de escrituras autónomas de bots o IAs.
    // Toda escritura requiere usuario humano autenticado con rol gerencial o superadmin.
    match /liquidaciones_pagos/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /finanzas_audit_trail/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /cfo-dashboard/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /cfo_dashboard/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // AUDITORÍA Y CERTIFICACIÓN DE SENTADOS CONFIRMADOS:
    // Lectura permitida a usuarios autenticados.
    // Escritura restringida a SuperAdmin o Gerencia.
    match /nodus_auditoria_sentados_confirmados/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion();
    }

    // NODUS: sincronización de coordinadores. Lectura autenticada (sin fuga pública).
    match /nodus_coordinadores_c1c2/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion() || (request.resource.data != null && request.resource.data.get('robot_token', '') == "NODUS_ROBOT_CPSL_2026_SECRET");
    }
    match /graduados_lineage_master/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /goals_sentinel_audits/{document=**} {
      allow read, write: if isAuthenticated();
    }
    // Roles autorizados en la ruta /monitor-imos (App.jsx). El rol se lee del
    // perfil users/{uid}, que el propio usuario no puede modificar.
    function isImoStaff() {
      return isGerenteODireccion() || callerHasAnyRole(IMO_STAFF_ROLES());
    }
    function IMO_STAFF_ROLES() {
      return ['direccion', 'cfo', 'ceo', 'cco', 'gerente', 'superadmin', 'consolidado', 'director_maestria', 'coord_c1', 'coordinador_c1', 'coordinador_c1c2', 'coord_c1_c2', 'coord_jr', 'coord_maestria', 'coordinador_mj', 'coordinador_maestria'];
    }
    // Shared capability links: a random 20-character campaign id grants access
    // only to that campaign. Profile selection is self-declared, NOT Firebase identity.
    // No public listing of campaigns or canonical missions is permitted.
    function activeImoCampaign(campaignId) {
      return get(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.status == 'active';
    }
    function validImoProfile(campaignId, missionId, enroladoId, reportedName) {
      let m = get(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)).data;
      return activeImoCampaign(campaignId) && enroladoId in m.enroladoIds && reportedName == m.imoNombre;
    }
    function imoWindowOpen(campaignId, missionId) {
      let windowPath = /databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_progress/window;
      let openedAt = get(windowPath).data.openedAt;
      return openedAt is timestamp && request.time <= openedAt + duration.value(30600, 's');
    }
    function matchingImoConfirmation(campaignId, missionId, enroladoId, eventId, after, sessionId, reportedName) {
      let confirmationPath = /databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_confirmations/$(enroladoId);
      let confirmation = getAfter(confirmationPath).data;
      return confirmation.get('eventId', '') == eventId &&
        confirmation.get('contacto', null) == after.contacto &&
        confirmation.get('asistencia', null) == after.asistencia &&
        confirmation.get('sessionId', '') == sessionId &&
        confirmation.get('reportedName', '') == reportedName;
    }
    function matchesPreviousImoState(path, before) {
      let previous = get(path).data;
      return before == {'contacto': previous.contacto, 'asistencia': previous.asistencia};
    }
    function matchingImoBefore(campaignId, missionId, enroladoId, before) {
      let confirmationPath = /databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_confirmations/$(enroladoId);
      return exists(confirmationPath) ?
        matchesPreviousImoState(confirmationPath, before) :
        before == {'contacto': false, 'asistencia': false};
    }
    match /imo_campaign_keys/{key} {
      allow read: if isAuthenticated() || isImoStaff();
      allow create: if isImoStaff() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /imo_campaigns/{campaignId} {
      allow get: if isAuthenticated() || isImoStaff() || (campaignId.matches('^[A-Za-z0-9]{20}$') && resource.data.status == 'active');
      allow list: if isAuthenticated() || isImoStaff();
      allow create: if isImoStaff() && campaignId.matches('^[A-Za-z0-9]{20}$') && request.resource.data.keys().hasOnly([
        'schemaVersion', 'sede', 'targetTeam', 'c1Date', 'status', 'createdAt', 'createdBy', 'count', 'missionKind'
      ]) && request.resource.data.schemaVersion == 2 && request.resource.data.status == 'active' &&
        (!('missionKind' in request.resource.data) || request.resource.data.missionKind == 'registered-c1-contact') &&
        request.resource.data.targetTeam is int && request.resource.data.targetTeam > 0 &&
        request.resource.data.sede is string && request.resource.data.sede.size() > 0 &&
        request.resource.data.c1Date is string && request.resource.data.c1Date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.count <= 200 &&
        request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isImoStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['active', 'closed'];
      allow delete: if false;
      match /profiles/{missionId} {
        allow read: if isImoStaff() || activeImoCampaign(campaignId);
        allow create: if isImoStaff() && request.resource.data.keys().hasOnly(['schemaVersion', 'campaignId', 'imoNombre', 'originTeam', 'targetTeam', 'sede', 'c1Date', 'enroladoIds', 'enrolados', 'missionKind']) &&
          request.resource.data.get('missionKind', '') == getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.get('missionKind', '') &&
          request.resource.data.schemaVersion == 2 && request.resource.data.campaignId == campaignId &&
          request.resource.data.targetTeam == getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.targetTeam &&
          request.resource.data.sede == getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.sede &&
          request.resource.data.c1Date == getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.c1Date &&
          request.resource.data.enroladoIds is list && request.resource.data.enroladoIds.size() > 0 && request.resource.data.enroladoIds.size() <= 100 && request.resource.data.enrolados.size() == request.resource.data.enroladoIds.size();
        allow update, delete: if false;
        match /imo_progress/{progressId} {
          allow get: if isImoStaff() || activeImoCampaign(campaignId);
          allow list: if isImoStaff();
          allow create: if progressId == 'window' && activeImoCampaign(campaignId) &&
            exists(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)) &&
            request.resource.data.keys().hasAll(['campaignId', 'openedAt']) &&
            request.resource.data.keys().hasOnly(['campaignId', 'openedAt']) &&
            request.resource.data.get('campaignId', '') == campaignId &&
            request.resource.data.openedAt is timestamp && request.resource.data.openedAt == request.time;
          allow update, delete: if false;
        }
        match /imo_confirmations/{enroladoId} {
          allow read: if isImoStaff() || activeImoCampaign(campaignId);
          allow create, update: if request.resource.data.keys().hasAll(['contacto', 'asistencia', 'campaignId', 'reportedName', 'sessionId', 'updatedAt', 'eventId']) &&
            request.resource.data.keys().hasOnly(['contacto', 'asistencia', 'campaignId', 'reportedName', 'sessionId', 'updatedAt', 'eventId']) &&
            request.resource.data.get('campaignId', '') == campaignId &&
            request.resource.data.contacto is bool && request.resource.data.asistencia is bool &&
            request.resource.data.sessionId is string && request.resource.data.sessionId.size() >= 20 && request.resource.data.sessionId.size() <= 64 &&
            request.resource.data.updatedAt == request.time &&
            existsAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_events/$(request.resource.data.eventId));
          allow delete: if false;
        }
        match /imo_events/{eventId} {
          allow read: if isImoStaff();
          allow create: if request.resource.data.keys().hasAll(['campaignId', 'enroladoId', 'before', 'after', 'reportedName', 'sessionId', 'identity', 'at', 'source']) &&
            validImoProfile(campaignId, missionId, request.resource.data.enroladoId, request.resource.data.reportedName) &&
            imoWindowOpen(campaignId, missionId) &&
            request.resource.data.keys().hasOnly(['campaignId', 'enroladoId', 'before', 'after', 'reportedName', 'sessionId', 'identity', 'at', 'source']) &&
            request.resource.data.get('campaignId', '') == campaignId &&
            request.resource.data.at == request.time && request.resource.data.identity == 'self-selected' && request.resource.data.source == 'mision-imo-v2' &&
            request.resource.data.after.keys().hasOnly(['contacto', 'asistencia']) &&
            request.resource.data.after.contacto is bool && request.resource.data.after.asistencia is bool &&
            matchingImoBefore(campaignId, missionId, request.resource.data.enroladoId, request.resource.data.before) &&
            matchingImoConfirmation(campaignId, missionId, request.resource.data.enroladoId, eventId, request.resource.data.after, request.resource.data.sessionId, request.resource.data.reportedName);
          allow update, delete: if false;
        }
      }
    }
    match /imo_missions/{missionId} {
      allow read: if isImoStaff();
      allow create: if isImoStaff() && request.resource.data.schemaVersion == 2 &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time &&
        request.resource.data.originTeam is int && request.resource.data.originTeam >= 0 &&
        request.resource.data.originTeam != request.resource.data.targetTeam &&
        request.resource.data.enroladoIds is list && request.resource.data.enroladoIds.size() > 0 && request.resource.data.enroladoIds.size() <= 100 &&
        request.resource.data.enrolados.size() == request.resource.data.enroladoIds.size() &&
        request.resource.data.get('missionKind', '') == getAfter(/databases/$(database)/documents/imo_campaigns/$(request.resource.data.campaignId)).data.get('missionKind', '') &&
        getAfter(/databases/$(database)/documents/imo_campaigns/$(request.resource.data.campaignId)).data.targetTeam == request.resource.data.targetTeam &&
        getAfter(/databases/$(database)/documents/imo_campaigns/$(request.resource.data.campaignId)).data.c1Date == request.resource.data.c1Date &&
        getAfter(/databases/$(database)/documents/imo_campaigns/$(request.resource.data.campaignId)).data.sede == request.resource.data.sede;
      allow update, delete: if isGerenteODireccion() && resource.data.get('schemaVersion', 1) != 2;
    }
    match /{path=**}/imo_confirmations/{enroladoId} {
      allow read: if isImoStaff();
    }
    match /{path=**}/imo_progress/{progressId} {
      allow read: if isImoStaff();
    }
    match /imo_private_mission_windows/{campaignId}/profiles/{windowId} {
      allow read: if isImoStaff();
      allow write: if false;
    }
    match /user_kpi_targets/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /nodus_predictor_portfolio/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /nodus_hr_sentinel/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /checklist_tasks/{document=**} {
      allow read: if canReadTask(resource.data) || canReadDualTask(resource.data);
      allow write: if isSuperAdmin() || isGerenteODireccion();
    }
    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /kpis_entrenadores_llamadas/{document=**} {
      allow read, write: if isAuthenticated();
    }
    // INMUTABILIDAD LEGAL ABSOLUTA - Onboarding Legal y Firmas Digitales
    // Borrado bloqueado para todos (incluso superadmin) para preservar validez probatoria contractual.
    // Updates restringidos únicamente a metadatos de sincronización PDF, prohibiendo cualquier
    // alteración de firma, DNI, identificación, timestamp o identidad del firmante.
    match /px_legal_signatures/{signatureId} {
      allow read: if isSuperAdmin() || isGerenteODireccion() || (isAuthenticated() && resource.data.participant_id == email());
      allow create: if isAuthenticated()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.participant_id == email()
        && request.resource.data.id == signatureId
        && request.resource.data.signed_at == request.time
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.signature_data_url is string
        && request.resource.data.signature_data_url.size() > 0
        && request.resource.data.signature_data_url.size() < 700000
        && request.resource.data.docs_accepted is list
        && request.resource.data.docs_accepted.size() > 0;
      allow update: if (isSuperAdmin() || isGerenteODireccion() || (isAuthenticated()
          && resource.data.owner_uid == request.auth.uid
          && resource.data.participant_id == email()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pdf_storage_path', 'pdf_download_url', 'pdfStoragePath', 'pdfDownloadUrl',
          'nodus_synced', 'nodus_synced_at', 'nodusSynced', 'nodusSyncedAt'
        ])
        && request.resource.data.signature_data_url == resource.data.signature_data_url
        && request.resource.data.signed_at == resource.data.signed_at
        && request.resource.data.get('participant_id', '') == resource.data.get('participant_id', '')
        && request.resource.data.get('dni', '') == resource.data.get('dni', '')
        && request.resource.data.get('identification', '') == resource.data.get('identification', '')
        && request.resource.data.get('owner_uid', '') == resource.data.get('owner_uid', '')
        && request.resource.data.get('id', '') == resource.data.get('id', '');
      allow delete: if false;
    }
    // Reportes de diagnóstico (Centro de Mando). Solo Super Admin lee.
    // "automatic" lo escribe únicamente el Admin SDK (bypass de reglas).
    // "copilot_deep": solo Super Admin, append-only y validado.
    match /platform_diagnostic_reports/{reportId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['source', 'title', 'content', 'createdAt', 'createdBy'])
        && request.resource.data.source == 'copilot_deep'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 50
        && request.resource.data.content.size() <= 50000
        && request.resource.data.createdBy == email()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // SEDES_INSTITUCIONALES: datos de cartas de invitación. Lectura pública (las
    // cartas se abren sin sesión). Escribe Super Admin o el gerente de ESA sede,
    // según users/{uid} (role/roles/sede), nunca según datos enviados por el cliente.
    function sedeInstitucionalNombre(sedeId) {
      return {'lima': 'Lima', 'quito': 'Quito', 'cuenca': 'Cuenca',
              'guayaquil': 'Guayaquil', 'medellin': 'Medellín', 'mexico': 'México'}.get(sedeId, '');
    }
    function canEditSedeInstitucional(sedeId) {
      return isSuperAdmin() || (
        isAuthenticated() &&
        sedeInstitucionalNombre(sedeId) != '' &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'gerente' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('appRole', '') == 'gerente' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['gerente'])
        ) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('sede', '') == sedeInstitucionalNombre(sedeId) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleSedes', {}).get('gerente', '') == sedeInstitucionalNombre(sedeId)
        )
      );
    }
    match /sedes_institucionales/{sedeId} {
      allow read: if true;
      allow create, update: if canEditSedeInstitucional(sedeId)
        && request.resource.data.keys().hasOnly(['razonSocial', 'identificacionFiscal', 'direccionFiscal', 'correoContacto', 'telefonoContacto'])
        && request.resource.data.razonSocial is string && request.resource.data.razonSocial.size() <= 500
        && request.resource.data.identificacionFiscal is string && request.resource.data.identificacionFiscal.size() <= 500
        && request.resource.data.direccionFiscal is string && request.resource.data.direccionFiscal.size() <= 500
        && request.resource.data.correoContacto is string && request.resource.data.correoContacto.size() <= 500
        && request.resource.data.telefonoContacto is string && request.resource.data.telefonoContacto.size() <= 500;
      allow delete: if isSuperAdmin();
    }

    // ============================================================================
    // GOBERNANZA Y SUPERVISIÓN: Omni-Auditor y Super-Agente Orquestador
    // ============================================================================
    match /sentinel_agent_heartbeats/{agentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion();
    }

    match /agent_deterministic_ledger/{actionHash} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion();
    }

    match /alerts_red_sentinel/{alertId} {
      allow read: if isSuperAdmin() || isGerenteODireccion();
      allow create: if isAuthenticated() && request.resource.data.keys().hasAll(['alertId', 'tipo', 'nivel', 'timestamp', 'destinatarios']);
      allow update, delete: if isSuperAdmin();
    }

    match /ai_pending_approvals/{approvalId} {
      allow read: if isSuperAdmin() || isGerenteODireccion();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isGerenteODireccion();
    }

    // ============================================================================
    // MÓDULO DE ALIADOS: Guía Operativa C1 y C2, encuestas, checklist y bitácora de seguridad
    // Reglas de producción verificadas para registro de encuestas, Staff de Mesa y retiros automáticos (2026-11-06)
    // ============================================================================
    match /encuestas_aliados/{uid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /aliados_autorizados/{emailId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /aliados_sesiones/{uid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /aliados_conexiones_log/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /records/{uid} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();

      match /events/{eventId} {
        allow read, create, update: if true;
        allow delete: if isSuperAdmin();
      }
    }

    // ============================================================================
    // MÓDULO DE STAFF DE MESA: Guía Operativa, Encuestas, Sesiones y Bitácora de Seguridad
    // ============================================================================
    match /encuestas_staff_mesa/{docId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /staff_mesa_autorizados/{docId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /staff_mesa_sesiones/{docId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /staff_mesa_conexiones_log/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /staff_mesa_records/{docId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();

      match /{allSubcollections=**} {
        allow read, create, update: if true;
        allow delete: if isSuperAdmin();
      }
    }

    // ============================================================================
    // CONTRATO CAMINATA SOBRE FUEGO: Registro legal y firma digital pública
    // Unicidad atómica en motor Firestore: ID determinístico doc_<numeroDocumentoNorm>
    // ============================================================================
    match /contratos_caminata_fuego/{contratoId} {
      allow read: if true;
      allow create: if request.resource.data.numeroDocumentoNorm is string
        && request.resource.data.numeroDocumentoNorm.matches('^[A-Z0-9]{4,24}$')
        && contratoId == 'doc_' + request.resource.data.numeroDocumentoNorm
        && !exists(/databases/$(database)/documents/contratos_caminata_fuego/$(contratoId))
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 180;
      allow update: if isSuperAdmin();
      allow delete: if isAuthenticated();
    }

    // ============================================================================
    // CONTRATO MAESTRÍA LIMA: Registro legal y firma digital pública
    // Unicidad atómica en motor Firestore: ID determinístico doc_<numeroDocumentoNorm>
    // ============================================================================
    match /contratos_maestria_lima/{contratoId} {
      allow read: if true;
      allow create: if request.resource.data.numeroDocumentoNorm is string
        && request.resource.data.numeroDocumentoNorm.matches('^[A-Z0-9]{4,24}$')
        && contratoId == 'doc_' + request.resource.data.numeroDocumentoNorm
        && !exists(/databases/$(database)/documents/contratos_maestria_lima/$(contratoId))
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 180;
      allow update: if isSuperAdmin();
      allow delete: if isAuthenticated();
    }

    // ============================================================================
    // CONTROL ASISTENCIA CAMINATA SOBRE FUEGO LIMA: Operación interna Causa OS
    // Asignación Equipo/FDS, asistencia en vivo (asistio), contingencias y _config_evento
    // ============================================================================
    match /control_asistencia_fuego_lima/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.keys().size() <= 50;
      allow delete: if isAuthenticated();
    }
  }
}



rules_version = '2';
// ============================================================================
// firestore.rules — SO-AR / centro-operativo-cpsl
// Auditada línea por línea contra el uso real de Firestore en el código (26/08/2026):
// se revisaron todas las llamadas collection(db, ...) / doc(db, ...) del proyecto y
// se confirmó que las 14 colecciones que la app usa hoy están cubiertas abajo, ya sea
// con una regla específica o dejadas explícitamente abiertas (ver sección "Qué NO
// cambia"). Enviada a despliegue el 26/08/2026 con confirmación explícita de Jose.
//
// Qu├® resuelve respecto a lo que est├í activo hoy en producci├│n:
//  1. Elimina el `match /{document=**} { allow read, write: if request.auth != null; }`
//     que permite a CUALQUIER usuario autenticado (sin importar rol o sede) leer y
//     escribir CUALQUIER documento de CUALQUIER colecci├│n.
//  2. Cierra la escritura p├║blica en colecciones de Nodus; las automatizaciones
//     deben publicar con credenciales de backend, no con secretos en documentos.
//  3. Usa el correo (request.auth.token.email) para verificar due├▒o/rol en vez de
//     request.auth.uid ÔÇö porque toda la app (AuthContext, ChecklistContext,
//     NotificationContext, auditService, etc.) guarda userId/ownerId/assignedToEmail
//     como CORREO, nunca como el uid real de Firebase Auth. Esa es la causa ra├¡z del
//     Hallazgo #2 de la auditor├¡a original (notificaciones, colaboraci├│n, venues,
//     ciclos y reportes fallando en silencio para roles no-superadmin).
//
// Qu├® NO cambia (a prop├│sito, para no romper nada que no revis├® a fondo):
//  Las colecciones staff_directory, managers_directory, excellence_standards,
//  kpi_reports, learning_logs, qt_directory, success_patterns, sync_history y
//  user_stats se dejan EXACTAMENTE como est├ín hoy (cualquier autenticado lee y
//  escribe) porque no alcanc├® a auditar el detalle de cada una y prefiero no
//  inventar una restricci├│n que bloquee algo que no vi. Quedan marcadas abajo
//  con un TODO para una siguiente pasada.
//
// Lista de gerencia/direcci├│n (funci├│n isGerenteODireccion): se extrajo del
// ├║ltimo snapshot de src/data/usersToImport.js en GitHub (anterior a la
// migraci├│n a Firestore). Esa lista puede estar desactualizada ÔÇö rev├¡sala y
// corr├¡gela antes de desplegar. Debe mantenerse igual que
// src/config/permissions.js (GERENCIA_ROLES/SUPER_ADMIN_EMAILS); no se
// sincronizan solas, as├¡ que si cambia gerencia hay que actualizar AMBOS lugares.
//
// ACTUALIZACIÓN 29/08/2026 (confirmada explícitamente por José): se agregó
// isOperationalProgressUpdate() en la regla de "tasks" — ver esa función más abajo
// para el detalle del bug real que corrige (permission-denied al marcar checklists
// del catálogo base, reportado como "Revisa los permisos de Firestore").
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Debe coincidir con SUPER_ADMIN_EMAILS en src/config/permissions.js
    function isSuperAdmin() {
      return isAuthenticated() && email() in [
        'jose.sanchez@crearpsl.net',
        'armando.pilacuan@gmail.com',
        'paul.sosa@crearpsl.net'
      ];
    }

    // Lista extra├¡da de usersToImport.js (snapshot GitHub, roles gerente/direccion/
    // cfo/cco/ceo/director_maestria/socio). VERIFICAR Y CORREGIR antes de desplegar.
    function isGerenteODireccion() {
      return isSuperAdmin() || (isAuthenticated() && email() in [
        'emely.leon@crearpsl.net',
        'fer.aragon@crearpsl.net',
        'andres.gomez@crearpsl.net',
        'gomeznueve@gmail.com',
        'contabilidad.global@crearpsl.net',
        'leandro.brunis@crearpsl.net',
        'josue.vera@crearpsl.net',
        'yurany.gonzalez@crearpsl.net',
        'nora.zamora@crearpsl.net',
        'emily.campuzano@crearpsl.net',
        'freddy.sosa@crearpsl.net',
        'diana.moscoso@crearpsl.net'
      ]);
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.assignedToEmail == email() ||
        (resourceData.assigned_to != null && resourceData.assigned_to == email()) ||
        // FIX (16/09/2026): las tareas "Personalizada (Directa)" compartidas entre
        // varias personas (ej. un mismo aviso mandado a varios gerentes a la vez)
        // usan el campo assignedToEmails (arreglo), nunca el singular
        // assignedToEmail. Antes, alguien que solo estaba en ese arreglo (y no era
        // SuperAdmin ni estaba en la lista fija de isGerenteODireccion()) no
        // cumplía isOwner() ni isCollaborator() con nada, así que Firestore
        // rechazaba el guardado de su evidencia/avance en esas tareas. Ahora
        // cuenta como dueño igual que si estuviera en el campo singular.
        (resourceData.assignedToEmails != null && email() in resourceData.assignedToEmails) ||
        // Se conserva por compatibilidad si alg├║n flujo futuro s├¡ llega a usar el uid real:
        (resourceData.ownerId != null && resourceData.ownerId == request.auth.uid)
      );
    }

    function isCollaborator(resourceData) {
      return isAuthenticated() && resourceData.collaborators != null && email() in resourceData.collaborators;
    }

    // (29/08/2026) FIX: las tareas del catálogo base (checklistData.js) son compartidas por
    // sede vía el mapa "completions" — nunca tienen assignedToEmail/ownerId ni un arreglo
    // "collaborators" explícito. Un Coordinador marcando su propio checklist (toggleTask,
    // % de avance, evidencia) nunca cumplía isOwner() ni isCollaborator(), así que Firestore
    // rechazaba la escritura con permission-denied ("Revisa los permisos de Firestore") en
    // cuanto el documento de la tarea ya existía (después del primer toque, o si "Reiniciar
    // Ciclo" ya corrió). Este helper permite a CUALQUIER autenticado tocar SOLO estos campos
    // operativos de progreso/completitud — nunca campos estructurales (dueño, rol, sede,
    // plazo, título), que siguen exigiendo isOwner()/isGerenteODireccion()/isSuperAdmin().
    //
    // FIX (16/09/2026): José reportó que los adjuntos/evidencia y las notas de
    // avance "no se guardan". Causa real (verificada leyendo el código): el botón
    // "Guardar Avances" de TaskDetailModal.jsx (handleSaveAll) manda SIEMPRE un
    // solo update con estos campos: progressPercentage, completed, status,
    // completedAt, assigneeProgress, evidenceUrl, evidence_url, evidences,
    // comments, notes, description, progressNotes, lastUpdated, lastUpdatedBy.
    // Esta lista solo permitía 9 de esos campos — le faltaban assigneeProgress,
    // evidences (el arreglo real de adjuntos, evidence_url es solo el legado de
    // uno solo), comments, notes, description, progressNotes, completedAt,
    // lastUpdated y lastUpdatedBy. Cualquier persona que guardara evidencia sin
    // ser SuperAdmin, sin estar en la lista fija de isGerenteODireccion(), y sin
    // ser dueño/colaborador de esa tarea puntual, era rechazada por Firestore en
    // cuanto intentaba guardar evidencia o una nota — sin importar que el propio
    // modal ya avisara "guarda tus avances antes de salir". Se agregan esos 9
    // campos, que son de bitácora/progreso propio, nunca estructurales (título,
    // asignación, rol, sede, plazo siguen exigiendo isOwner()/isGerenteODireccion()/
    // isSuperAdmin() como hasta ahora).
    function isOperationalProgressUpdate() {
      return isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completed', 'status', 'completions', 'progress', 'progressPercentage',
          'evidence_url', 'evidenceUrl', 'date', 'googleSynced',
          'assigneeProgress', 'evidences', 'comments', 'notes', 'description',
          'progressNotes', 'completedAt', 'lastUpdated', 'lastUpdatedBy',
          'updatedAt', 'updated_at', 'deadline'
        ]);
    }

    // (29/08/2026) MJ_CALENDARS: el rol operativo del usuario (coord_maestria,
    // director_maestria, etc.) no viaja en el token de autenticación ni se
    // puede inferir de una lista fija de correos como isGerenteODireccion().
    // El perfil users/{uid} es la fuente de roles administrada; las reglas de
    // users impiden que el propio usuario pueda cambiar sus roles.
    function callerRole() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
            in ['coord_maestria', 'director_maestria'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', [])
            .hasAny(['coord_maestria', 'director_maestria'])
        );
    }

    // HOJA EN BLANCO: Funciones de transversalidad
    function checkHojaEnBlancoAccess(docData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'entrenador' && (
              docData.get('assignedToEmail', '') == email() || 
              (docData.keys().hasAll(['assignedToEmails']) && email() in docData.assignedToEmails) ||
              docData.get('entrenadorEmail', '') == email() ||
              (docData.keys().hasAll(['entrenadores']) && email() in docData.entrenadores) ||
              docData.get('email', '') == email() ||
              docData.get('autorEmail', '') == email() ||
              docData.get('registradoPorEmail', '') == email()
            )) ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'entrenador' && 
             docData.get('sede', '') != '' && docData.get('sede', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sede)
          )
        )
      );
    }

    function canReadHojaEnBlanco() {
      return checkHojaEnBlancoAccess(resource.data);
    }
    
    function canWriteHojaEnBlanco() {
      return (request.resource == null && resource != null && checkHojaEnBlancoAccess(resource.data)) ||
             (request.resource != null && resource == null && checkHojaEnBlancoAccess(request.resource.data)) ||
             (request.resource != null && resource != null && checkHojaEnBlancoAccess(resource.data) && checkHojaEnBlancoAccess(request.resource.data));
    }

    // MJ_CALENDARS (29/08/2026): calendarios de Maestría del Juego por equipo
    // (CalendarioMJ.jsx), pedido por José a partir de 3 PDF de ejemplo reales.
    // Confirmado explícitamente por José antes de tocar firestore.rules.
    match /mj_calendars/{calendarId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion() || callerRole();
    }

    // TASKS
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || isGerenteODireccion() ||
                    isOwner(resource.data) ||
                    (isCollaborator(resource.data) &&
                     request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'progress', 'evidence_url', 'evidenceUrl', 'completions']) &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedToEmail', 'role', 'sede', 'ownerId'])) ||
                    isOperationalProgressUpdate();
      allow delete: if isGerenteODireccion() || isSuperAdmin();
    }

    // GOALS
    match /goals/{goalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // igual que antes: sin restringir por rol
      allow update: if isSuperAdmin() || isGerenteODireccion() || isOwner(resource.data);
      allow delete: if isSuperAdmin();
    }

    // REPORTS
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isGerenteODireccion() || isSuperAdmin();
    }

    // USER PROFILES (registro de ├║ltimo login / conexi├│n, doc ID = correo)
    match /user_profiles/{userDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && email() == userDocId;
    }

    // NOTIFICATIONS (userId siempre es el correo, nunca el uid)
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == email();
      // TRADEOFF: los productores (ChecklistContext, PortfolioBoard, ComunicadosOperativos,
      // scheduleGovernanceAgent, ExcellenceService) escriben desde el cliente a OTROS
      // destinatarios y no registran remitente verificable, así que Rules no puede validar
      // remitente->destinatario. Se limita al máximo: solo esquema conocido, sin leídas,
      // textos acotados. El destinatario es el único que puede leer/actualizar/borrar.
      // Pendiente recomendado: mover la publicación a backend (Cloud Function).
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['userId', 'title', 'message', 'read', 'created_at'])
        && request.resource.data.keys().hasOnly(['userId', 'title', 'message', 'read', 'created_at',
             'createdAt', 'timestamp', 'type', 'taskId', 'taskMessageId', 'taskTitle', 'inviterEmail',
             'inviterName', 'sede', 'standardId', 'priority', 'requiresAction', 'communicationId'])
        && request.resource.data.userId is string
        && request.resource.data.userId.matches('.+@.+')
        && request.resource.data.title is string && request.resource.data.title.size() <= 1000
        && request.resource.data.message is string && request.resource.data.message.size() <= 20000
        && request.resource.data.read == false
        && request.resource.data.created_at is string;
      allow update: if isAuthenticated() && resource.data.userId == email();
      allow delete: if isAuthenticated() && resource.data.userId == email();
    }

    // VENUES (sede, hotel, sal├│n)
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // CYCLES
    match /cycles/{cycleId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // MAIL (cola de la extensión Trigger Email)
    match /mail/{mailId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // HORARIOS Y TURNOS DE ENTRENAMIENTO (Causa OS)
    match /nodus_training_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // USERS
    // Los campos de rol y estado solo los pueden modificar SuperAdmins.
    // Los usuarios pueden mantener sus datos de perfil y elegir una vista entre
    // los roles que ya tienen asignados, sin poder ampliar esos roles.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == email() &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'displayName', 'photoURL', 'avatarUrl',
          'createdAt', 'lastLoginAt', 'updatedAt', 'lastSeenAt', 'preferences',
          'phone', 'provider', 'providerId'
        ])
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == email() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'photoURL', 'avatarUrl', 'lastLoginAt',
          'updatedAt', 'lastSeenAt', 'preferences', 'phone', 'provider',
          'providerId', 'activeRoleOverride'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeRoleOverride']) ||
          request.resource.data.activeRoleOverride in resource.data.get('roles', []) ||
          request.resource.data.activeRoleOverride == resource.data.get('role', '') ||
          request.resource.data.activeRoleOverride == resource.data.get('appRole', '')
        )
      );
      allow delete: if isSuperAdmin();

      match /copilot_chats/{chatId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
    }

    // ASIGNADOR OFICIAL DE ENTRENADORES. La pantalla guarda confirmaciones
    // separadas del calendario fuente y un log inmutable. Solo las personas
    // autorizadas pueden modificar la asignación; nadie puede borrar la
    // trazabilidad desde el cliente.
    function canManageTrainerAssignments() {
      return isAuthenticated() && email() in [
        'jose.sanchez@crearpsl.net',
        'fer.aragon@crearpsl.net',
        'fer.aragon@crearpsl.com',
        'paul.sosa@crearpsl.net',
        'andres.gomez@crearpsl.net',
        'gomeznueve@gmail.com'
      ];
    }
    match /asignaciones_entrenadores/{assignmentId} {
      allow read, create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    match /asignaciones_entrenadores_log/{logId} {
      allow read, create: if canManageTrainerAssignments();
      allow update, delete: if false;
    }
    function canSendOperationalCommunications() {
      return isAuthenticated() && email() in [
        'jose.sanchez@crearpsl.net', 'fer.aragon@crearpsl.net',
        'fer.aragon@crearpsl.com', 'paul.sosa@crearpsl.net',
        'andres.gomez@crearpsl.net', 'gomeznueve@gmail.com'
      ];
    }
    match /operational_communications/{communicationId} {
      allow read, create: if canSendOperationalCommunications();
      allow update, delete: if false;
    }

    // Conversación interna vinculada a una tarea. El mensaje es inmutable y
    // solo lo ven quien lo envió y quienes aparecen como destinatarios.
    match /task_messages/{messageId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderEmail == email() || email() in resource.data.recipientEmails);
      allow create: if isAuthenticated() &&
        request.resource.data.senderEmail == email() &&
        request.resource.data.taskId is string &&
        request.resource.data.body is string &&
        request.resource.data.recipientEmails is list;
      allow update, delete: if false;
    }
    // Proyección mínima de asignaciones confirmadas para el calendario global.
    // Solo publica nombre, evento y fecha de confirmación; nunca correos,
    // identidades de quien asignó ni la bitácora interna.
    match /calendario_asignaciones_publicas/{assignmentId} {
      allow read: if true;
      allow create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    // Calendario operativo: Causa OS conserva ajustes y nuevos eventos sin
    // alterar la hoja histórica. Los cambios se auditan de forma append-only.
    match /calendario_operativo_overrides/{eventId} {
      allow read, create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    match /calendario_operativo_custom/{eventId} {
      allow read, create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    match /calendario_operativo_log/{logId} {
      allow read, create: if canManageTrainerAssignments();
      allow update, delete: if false;
    }
    // Agenda publicada por el Asignador: solo fechas, sede, entrenamiento y
    // lugar que ya son visibles en los calendarios. No incluye datos de
    // usuarios ni auditoría. Permite reflejo en vivo para todos los roles.
    match /calendario_operativo_publico/{eventId} {
      allow read: if true;
      allow create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }

    // CONTROL DE PÓLIZAS: el resultado de cada validación queda persistido
    // para no reconsultar Drive al entrar. El historial es append-only: nadie
    // puede editar ni borrar eventos de auditoría desde el cliente.
    match /trainer_policy_reviews/{reviewId} {
      allow read, create, update: if canManageTrainerAssignments();
      allow delete: if false;
    }
    match /trainer_policy_audit/{auditId} {
      allow read, create: if canManageTrainerAssignments();
      allow update, delete: if false;
    }

    // NODUS: acceso gerencial/autenticado. Las escrituras del robot se ejecutan
    // vía backend con credenciales de servicio y no se aceptan tokens públicos en
    // Firestore Rules.
    match /nodus_kpis_sincronizados/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion();
    }

    // FUTUROS IMPOSIBLES: NODUS conserva la fuente; Causa OS solo consume
    // el snapshot publicado y registra las decisiones de revisión por
    // separado. El historial no puede ser alterado desde el cliente.
    match /nodus_futuros_imposibles/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    match /nodus_fi_reviews/{reviewId} {
      allow read, create, update: if isGerenteODireccion() || isSuperAdmin();
      allow delete: if false;
    }
    match /nodus_fi_audit/{auditId} {
      allow read, create: if isGerenteODireccion() || isSuperAdmin();
      allow update, delete: if false;
    }
    // Catálogo técnico sin PII, producido por el agente servidor de
    // descubrimiento. Causa OS lo lee para informar qué contrato NODUS está
    // disponible; ningún cliente puede alterarlo.
    match /nodus_source_catalog/{document=**} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
    }

    // Respaldo bruto de NODUS: puede contener identificadores y contactos de
    // participantes. Solo gerencia/superadministración puede leerlo; el agente
    // lo escribe mediante Admin SDK y ningún cliente puede modificarlo.
    match /nodus_archive_runs/{runId} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
      match /pages/{pageId} {
        allow read: if isGerenteODireccion() || isSuperAdmin();
        allow write: if false;
        match /chunks/{chunkId} {
          allow read: if isGerenteODireccion() || isSuperAdmin();
          allow write: if false;
        }
      }
    }

    // Auditoría de accesos y estadísticas de cuentas NODUS: se limita la
    // lectura por contener identidades y marcas de conexión de usuarios.
    match /nodus_user_access_latest/{documentId} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
    }
    match /nodus_user_access_runs/{runId} {
      allow read: if isGerenteODireccion() || isSuperAdmin();
      allow write: if false;
      match /pages/{pageId} {
        allow read: if isGerenteODireccion() || isSuperAdmin();
        allow write: if false;
        match /chunks/{chunkId} {
          allow read: if isGerenteODireccion() || isSuperAdmin();
          allow write: if false;
        }
      }
    }

    // ------------------------------------------------------------------------
    // COLECCIONES AUDITADAS CON PERMISOS AMPLIOS DE COLABORACIÓN OPERATIVA
    // ------------------------------------------------------------------------
    match /staff_directory/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /managers_directory/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /excellence_standards/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /kpi_reports/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /learning_logs/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /qt_directory/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /success_patterns/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /sync_history/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /user_stats/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // COLECCIONES ADICIONALES (FALTANTES REVELADAS EN AUDITORÍA FORENSE)
    // ------------------------------------------------------------------------
    match /participants/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /sugerencias_soporte/{document=**} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
    match /opt_outs/{document=**} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }
    match /recurring_tasks_templates/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /llamadas_grupales_historial/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /notas_seguimiento/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /liquidaciones_pagos/{document=**} {
      allow read, write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /finanzas_audit_trail/{document=**} {
      allow read, write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /nodus_coordinadores_c1c2/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isGerenteODireccion();
    }
    match /graduados_lineage_master/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /goals_sentinel_audits/{document=**} {
      allow read, write: if isAuthenticated();
    }
    // Shared capability links: a random 20-character campaign id grants access
    // only to that campaign. Profile selection is self-declared, NOT Firebase identity.
    // No public listing of campaigns or canonical missions is permitted.
    function activeImoCampaign(campaignId) {
      return get(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.status == 'active';
    }
    function validImoProfile(campaignId, missionId, enroladoId, reportedName) {
      let m = get(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)).data;
      return activeImoCampaign(campaignId) && enroladoId in m.enroladoIds && reportedName == m.imoNombre;
    }
    match /imo_campaign_keys/{key} {
      allow read: if isGerenteODireccion();
      allow create: if isGerenteODireccion() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /imo_campaigns/{campaignId} {
      allow get: if isGerenteODireccion() || (campaignId.matches('^[A-Za-z0-9]{20}$') && resource.data.status == 'active');
      allow list: if isGerenteODireccion();
      allow create: if isGerenteODireccion() && campaignId.matches('^[A-Za-z0-9]{20}$') && request.resource.data.keys().hasOnly([
        'schemaVersion', 'sede', 'targetTeam', 'c1Date', 'status', 'createdAt', 'createdBy', 'count'
      ]) && request.resource.data.schemaVersion == 2 && request.resource.data.status == 'active' &&
        request.resource.data.targetTeam is int && request.resource.data.targetTeam > 0 &&
        request.resource.data.sede is string && request.resource.data.sede.size() > 0 &&
        request.resource.data.c1Date is string && request.resource.data.c1Date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.count <= 100 &&
        request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isGerenteODireccion() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['active', 'closed'];
      allow delete: if false;
      match /profiles/{missionId} {
        allow read: if isGerenteODireccion() || activeImoCampaign(campaignId);
        allow create: if isGerenteODireccion() && request.resource.data.keys().hasOnly(['schemaVersion', 'campaignId', 'imoNombre', 'originTeam', 'targetTeam', 'sede', 'c1Date', 'enroladoIds', 'enrolados']) &&
          request.resource.data.schemaVersion == 2 && request.resource.data.campaignId == campaignId &&
          request.resource.data.targetTeam == getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.targetTeam &&
          request.resource.data.sede == getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)).data.sede &&
          request.resource.data.enroladoIds is list && request.resource.data.enroladoIds.size() > 0 && request.resource.data.enroladoIds.size() <= 100 && request.resource.data.enrolados.size() == request.resource.data.enroladoIds.size();
        allow update, delete: if false;
        match /imo_confirmations/{enroladoId} {
          allow read: if isGerenteODireccion() || activeImoCampaign(campaignId);
          allow create, update: if validImoProfile(campaignId, missionId, enroladoId, request.resource.data.reportedName) &&
            request.resource.data.keys().hasOnly(['contacto', 'asistencia', 'reportedName', 'sessionId', 'updatedAt', 'eventId']) &&
            request.resource.data.contacto is bool && request.resource.data.asistencia is bool &&
            request.resource.data.sessionId is string && request.resource.data.sessionId.size() >= 20 && request.resource.data.sessionId.size() <= 64 &&
            request.resource.data.updatedAt == request.time &&
            !exists(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_events/$(request.resource.data.eventId)) &&
            getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_events/$(request.resource.data.eventId)).data.after == {'contacto': request.resource.data.contacto, 'asistencia': request.resource.data.asistencia} &&
            getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_events/$(request.resource.data.eventId)).data.enroladoId == enroladoId &&
            getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_events/$(request.resource.data.eventId)).data.sessionId == request.resource.data.sessionId;
          allow delete: if false;
        }
        match /imo_events/{eventId} {
          allow read: if isGerenteODireccion();
          allow create: if validImoProfile(campaignId, missionId, request.resource.data.enroladoId, request.resource.data.reportedName) &&
            request.resource.data.keys().hasOnly(['enroladoId', 'before', 'after', 'reportedName', 'sessionId', 'identity', 'at', 'source']) &&
            request.resource.data.at == request.time && request.resource.data.identity == 'self-selected' && request.resource.data.source == 'mision-imo-v2' &&
            request.resource.data.after.keys().hasOnly(['contacto', 'asistencia']) &&
            request.resource.data.after.contacto is bool && request.resource.data.after.asistencia is bool &&
            request.resource.data.before == (exists(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_confirmations/$(request.resource.data.enroladoId)) ?
              {'contacto': get(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_confirmations/$(request.resource.data.enroladoId)).data.contacto, 'asistencia': get(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_confirmations/$(request.resource.data.enroladoId)).data.asistencia} : {'contacto': false, 'asistencia': false}) &&
            getAfter(/databases/$(database)/documents/imo_campaigns/$(campaignId)/profiles/$(missionId)/imo_confirmations/$(request.resource.data.enroladoId)).data.eventId == eventId;
          allow update, delete: if false;
        }
      }
    }
    match /imo_missions/{missionId} {
      allow read: if isGerenteODireccion();
      allow create: if isGerenteODireccion() && request.resource.data.schemaVersion == 2 &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time &&
        request.resource.data.originTeam is int && request.resource.data.originTeam > 0 &&
        request.resource.data.originTeam != request.resource.data.targetTeam &&
        request.resource.data.enroladoIds is list && request.resource.data.enroladoIds.size() > 0 && request.resource.data.enroladoIds.size() <= 100 &&
        request.resource.data.enrolados.size() == request.resource.data.enroladoIds.size() &&
        getAfter(/databases/$(database)/documents/imo_campaigns/$(request.resource.data.campaignId)).data.targetTeam == request.resource.data.targetTeam &&
        getAfter(/databases/$(database)/documents/imo_campaigns/$(request.resource.data.campaignId)).data.sede == request.resource.data.sede;
      allow update, delete: if isGerenteODireccion() && resource.data.get('schemaVersion', 1) != 2;
    }
    match /{path=**}/imo_confirmations/{enroladoId} {
      allow read: if isGerenteODireccion();
    }
    match /user_kpi_targets/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /nodus_predictor_portfolio/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /nodus_hr_sentinel/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /checklist_tasks/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }
    match /kpis_entrenadores_llamadas/{document=**} {
      allow read, write: if isAuthenticated();
    }
    // Cada participante puede crear y consultar únicamente sus propias firmas.
    match /px_legal_signatures/{signatureId} {
      allow read: if isSuperAdmin() || isGerenteODireccion() || (isAuthenticated() && resource.data.participant_id == email());
      allow create: if isAuthenticated()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.participant_id == email()
        && request.resource.data.id == signatureId
        && request.resource.data.signed_at == request.time
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.signature_data_url is string
        && request.resource.data.signature_data_url.size() > 0
        && request.resource.data.signature_data_url.size() < 700000
        && request.resource.data.docs_accepted is list
        && request.resource.data.docs_accepted.size() > 0;
      // Los datos de aceptación y la firma son inmutables desde el cliente.
      allow update: if isSuperAdmin() || (isAuthenticated()
        && resource.data.owner_uid == request.auth.uid
        && resource.data.participant_id == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pdf_storage_path', 'pdf_download_url', 'pdfStoragePath', 'pdfDownloadUrl',
          'nodus_synced', 'nodus_synced_at', 'nodusSynced', 'nodusSyncedAt'
        ]));
      allow delete: if isSuperAdmin();
    }
  }
}

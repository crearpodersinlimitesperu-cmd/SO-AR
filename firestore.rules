rules_version = '2';
// ============================================================================
// PROPUESTA DE firestore.rules — SO-AR / centro-operativo-cpsl
// Generada para revisión. NO está desplegada. NO reemplaza nada todavía.
//
// Qué resuelve respecto a lo que está activo hoy en producción:
//  1. Elimina el `match /{document=**} { allow read, write: if request.auth != null; }`
//     que permite a CUALQUIER usuario autenticado (sin importar rol o sede) leer y
//     escribir CUALQUIER documento de CUALQUIER colección.
//  2. Cierra la escritura sin autenticación en `nodus_kpis_sincronizados` para
//     cualquiera que NO tenga el robot_token (se mantiene el mecanismo del robot,
//     solo se le agrega también exigir lectura autenticada, igual que ya tenía).
//  3. Usa el correo (request.auth.token.email) para verificar dueño/rol en vez de
//     request.auth.uid — porque toda la app (AuthContext, ChecklistContext,
//     NotificationContext, auditService, etc.) guarda userId/ownerId/assignedToEmail
//     como CORREO, nunca como el uid real de Firebase Auth. Esa es la causa raíz del
//     Hallazgo #2 de la auditoría original (notificaciones, colaboración, venues,
//     ciclos y reportes fallando en silencio para roles no-superadmin).
//
// Qué NO cambia (a propósito, para no romper nada que no revisé a fondo):
//  Las colecciones staff_directory, managers_directory, excellence_standards,
//  kpi_reports, learning_logs, qt_directory, success_patterns, sync_history y
//  user_stats se dejan EXACTAMENTE como están hoy (cualquier autenticado lee y
//  escribe) porque no alcancé a auditar el detalle de cada una y prefiero no
//  inventar una restricción que bloquee algo que no vi. Quedan marcadas abajo
//  con un TODO para una siguiente pasada.
//
// Lista de gerencia/dirección (función isGerenteODireccion): se extrajo del
// último snapshot de src/data/usersToImport.js en GitHub (anterior a la
// migración a Firestore). Esa lista puede estar desactualizada — revísala y
// corrígela antes de desplegar. Debe mantenerse igual que
// src/config/permissions.js (GERENCIA_ROLES/SUPER_ADMIN_EMAILS); no se
// sincronizan solas, así que si cambia gerencia hay que actualizar AMBOS lugares.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Debe coincidir con SUPER_ADMIN_EMAILS en src/config/permissions.js
    function isSuperAdmin() {
      return isAuthenticated() && email() in [
        'jose.sanchez@crearpsl.net',
        'armando.pilacuan@gmail.com',
        'paul.sosa@crearpsl.net'
      ];
    }

    // Lista extraída de usersToImport.js (snapshot GitHub, roles gerente/direccion/
    // cfo/cco/ceo/director_maestria/socio). VERIFICAR Y CORREGIR antes de desplegar.
    function isGerenteODireccion() {
      return isSuperAdmin() || (isAuthenticated() && email() in [
        'emely.leon@crearpls.com',
        'emely.leon@crearpsl.net',
        'fer.aragon@crearpsl.net',
        'andres.gomez@crearpsl.net',
        'gomeznueve@gmail.com',
        'contabilidad.global@crearpsl.net',
        'leandro.brunis@crearpsl.net',
        'josue.vera@crearpsl.net',
        'yurany.gonzalez@crearpsl.net',
        'nora.zamora@crearpsl.net',
        'emily.campuzano@crearpsl.net',
        'freddy.sosa@crearpsl.net'
      ]);
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.assignedToEmail == email() ||
        (resourceData.assigned_to != null && resourceData.assigned_to == email()) ||
        // Se conserva por compatibilidad si algún flujo futuro sí llega a usar el uid real:
        (resourceData.ownerId != null && resourceData.ownerId == request.auth.uid)
      );
    }

    function isCollaborator(resourceData) {
      return isAuthenticated() && resourceData.collaborators != null && email() in resourceData.collaborators;
    }

    // TASKS
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || isGerenteODireccion() ||
                    isOwner(resource.data) ||
                    (isCollaborator(resource.data) &&
                     request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'progress', 'evidence_url', 'evidenceUrl', 'completions']) &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedToEmail', 'role', 'sede', 'ownerId']));
      allow delete: if isGerenteODireccion() || isSuperAdmin();
    }

    // GOALS
    match /goals/{goalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // igual que antes: sin restringir por rol
      allow update: if isSuperAdmin() || isGerenteODireccion() || isOwner(resource.data);
      allow delete: if isSuperAdmin();
    }

    // REPORTS
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isGerenteODireccion() || isSuperAdmin();
    }

    // USER PROFILES (registro de último login / conexión, doc ID = correo)
    match /user_profiles/{userDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && email() == userDocId;
    }

    // NOTIFICATIONS (userId siempre es el correo, nunca el uid)
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == email();
      allow delete: if isAuthenticated() && resource.data.userId == email();
    }

    // VENUES (sede, hotel, salón)
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // CYCLES
    match /cycles/{cycleId} {
      allow read: if isAuthenticated();
      allow write: if isGerenteODireccion() || isSuperAdmin();
    }

    // MAIL (cola de la extensión Trigger Email)
    match /mail/{mailId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // USERS (colección de perfiles, SuperAdmin o el propio usuario escribe su perfil)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);

      // Historial de chats del Copiloto IA (AICopilot.jsx): esta es la ÚNICA ruta de toda
      // la app donde currentUser.uid corresponde de verdad al uid real de Firebase Auth
      // (viene del objeto crudo de Firebase, no se sobreescribe en buildUserObject), así
      // que aquí sí se puede comparar contra request.auth.uid con seguridad.
      match /copilot_chats/{chatId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
    }

    // NODUS: se mantiene el mecanismo de token del robot (no requiere sesión porque
    // es un script, no una persona), pero ahora la lectura sí exige sesión iniciada.
    match /nodus_kpis_sincronizados/{document} {
      allow read: if isAuthenticated();
      allow write: if request.resource.data.robot_token == "NODUS_ROBOT_CPSL_2026_SECRET";
    }

    // ------------------------------------------------------------------------
    // TODO: revisar individualmente y restringir cuando se conozca el patrón
    // real de lectura/escritura de cada una. Por ahora se dejan EXACTAMENTE
    // como están hoy en producción (cualquier autenticado lee y escribe) para
    // no romper nada que no audité a fondo.
    // ------------------------------------------------------------------------
    match /staff_directory/{document} {
      allow read, write: if isAuthenticated();
    }
    match /managers_directory/{document} {
      allow read, write: if isAuthenticated();
    }
    match /excellence_standards/{document} {
      allow read, write: if isAuthenticated();
    }
    match /kpi_reports/{document} {
      allow read, write: if isAuthenticated();
    }
    match /learning_logs/{document} {
      allow read, write: if isAuthenticated();
    }
    match /qt_directory/{document} {
      allow read, write: if isAuthenticated();
    }
    match /success_patterns/{document} {
      allow read, write: if isAuthenticated();
    }
    match /sync_history/{document} {
      allow read, write: if isAuthenticated();
    }
    match /user_stats/{document} {
      allow read, write: if isAuthenticated();
    }
  }
}

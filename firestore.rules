rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'jose.sanchez@crearpsl.net',
          'armando.pilacuan@gmail.com',
          'paul.sosa@crearpsl.net'
        ] ||
        getUserData().role == 'superadmin' ||
        getUserData().role == 'direccion'
      );
    }
    
    function isGerente() {
      return isSuperAdmin() || (isAuthenticated() && getUserData().role == 'gerente');
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.ownerId == request.auth.uid || 
        resourceData.assignedToEmail == request.auth.token.email ||
        (resourceData.assigned_to != null && resourceData.assigned_to == request.auth.token.email)
      );
    }

    function isCollaborator(resourceData) {
      return isAuthenticated() && resourceData.collaborators != null && request.auth.token.email in resourceData.collaborators;
    }

    // TASKS
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      
      allow update: if isSuperAdmin() || isGerente() || 
                    (isOwner(resource.data) && request.resource.data.ownerId == resource.data.ownerId) ||
                    (isCollaborator(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'progress', 'evidence_url', 'evidenceUrl', 'completions']) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedToEmail', 'role', 'sede', 'ownerId']));
                    
      allow delete: if isGerente() || isSuperAdmin();
    }
    
    // GOALS
    match /goals/{goalId} {
      allow read: if isAuthenticated();
      allow create: if isGerente() || isSuperAdmin() || isAuthenticated(); // TODO: Restrict goal creation based on roles later
      allow update: if isSuperAdmin() || isGerente() || isOwner(resource.data);
      allow delete: if isSuperAdmin();
    }
    
    // REPORTS
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isGerente() || isSuperAdmin();
    }

    // USER PROFILES
    match /user_profiles/{userDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userDocId;
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // VENUES
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if isGerente() || isSuperAdmin();
    }

    // CYCLES
    match /cycles/{cycleId} {
      allow read: if isAuthenticated();
      allow write: if isGerente() || isSuperAdmin();
    }

    // MAIL
    match /mail/{mailId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
    }
  }
}
